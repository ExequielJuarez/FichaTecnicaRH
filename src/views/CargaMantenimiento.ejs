      </li>

    </ul>
  </nav>
</aside>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <header class="topbar">
      <button class="topbar__menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6"  x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <div class="topbar__mobile-brand" aria-hidden="true">
        <svg style="width:18px;height:18px;color:var(--color-primary)" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
        <span>Mantenimientos</span>
      </div>

      <nav class="topbar__breadcrumb" aria-label="Ruta de navegación">
        <a href="../../../Mantenimientos">Mantenimientos</a>
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        <span>Agregar mantenimiento</span>
      </nav>

      <div class="topbar__actions">
        <button class="topbar__notification-btn" aria-label="Notificaciones">
          <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
          <span class="topbar__notification-dot" aria-label="5 notificaciones">5</span>
        </button>
        <div class="topbar__user" role="button" tabindex="0">
          <svg class="topbar__user-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
          <span class="topbar__user-name">Administrador</span>
          <svg class="topbar__user-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        </div>
      </div>
    </header>

    <!-- ===================== MAIN ===================== -->
    <main class="main-content" id="main-content">

      <div class="page-header">
        <div class="page-header__left">
          <h2 class="page-title">Cargar Mantenimiento</h2>
          <p class="page-subtitle">Complete todos los datos del servicio de mantenimiento.</p>
        </div>
      </div>

      <form class="form" action="/CargaMantenimiento" method="post" >

        <!-- 1. SELECCIÓN DE VEHÍCULO -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--blue">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
            </div>
            <h3>Vehículo</h3>
          </div>

          <div class="form-group">
            <label for="id_vehiculo">Seleccionar vehículo <span class="required-star">*</span></label>
            <select name="id_vehiculo" id="id_vehiculo" required>
              <option value="">— Elegir vehículo —</option>

              <% vehiculos.forEach(vehiculo => { %>

                <option 
  value="<%= vehiculo.id_vehiculo %>"
  data-patente="<%= vehiculo.patente %>"
  data-detalle="<%= vehiculo.marca %> <%= vehiculo.modelo %>"
  data-km="<%= vehiculo.km_actual %>"
  <%= id_vehiculo_preseleccionado == vehiculo.id_vehiculo ? 'selected' : '' %>
>
  <%= vehiculo.id_vehiculo %> —
  <%= vehiculo.patente %> ·
  <%= vehiculo.marca %> <%= vehiculo.modelo %>
</option>

              <% }) %>
            </select>
          </div>

          <div class="vehicle-card" id="vehicle-card" aria-live="polite">
            <div class="vehicle-card__badge">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
            </div>
            <div class="vehicle-card__info">
              <div class="vehicle-card__patente" id="vc-patente">—</div>
              <div class="vehicle-card__detail"  id="vc-detalle">—</div>
            </div>
            <div class="vehicle-card__km" id="vc-km">— km</div>
          </div>
        </section>

        <!-- 2. INFORMACIÓN DEL SERVICIO -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--amber">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
            </div>
            <h3>Información del Servicio</h3>
          </div>

          <div class="form-group">
            <label for="tipo_servicio">Tipo de servicio <span class="required-star">*</span></label>
              <select name="tipo_servicio" id="tipo_servicio" required>
                <option value="">— Seleccionar servicio —</option>

                <option value="Cambio de aceite">Cambio de aceite</option>
                <option value="Cambio de filtros">Cambio de filtros</option>
                <option value="Service general">Service general</option>
                <option value="Frenos">Frenos</option>
                <option value="Electricidad">Electricidad</option>
                <option value="Suspensión">Suspensión</option>
                <option value="Motor">Motor</option>
                <option value="Transmisión">Transmisión</option>
                <option value="Neumáticos">Neumáticos</option>
                <option value="Alineación y balanceo">Alineación y balanceo</option>
              </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="fecha_inicio">Fecha de inicio <span class="required-star">*</span></label>
              <input type="date" name="fecha_inicio" id="fecha_inicio" required>
            </div>
            <div class="form-group">
              <label for="fecha_fin">Fecha de fin</label>
              <input type="date" name="fecha_fin" id="fecha_fin">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="km_servicio">Km al momento del servicio <span class="required-star">*</span></label>
              <input type="number" name="km_servicio" id="km_servicio" min="0" placeholder="Ej: 45200" required>
            </div>
            <div class="form-group">
              <label for="estado">Estado</label>
              <div class="estado-select-wrapper">
                <div class="estado-dot" id="estado-dot"></div>
                <select name="estado" id="estado">
                  <option value="Realizado">Realizado</option>
                  <option value="En proceso">En proceso</option>
                  <option value="Pendiente">Pendiente</option>
                  <option value="Cancelado">Cancelado</option>
                </select>
              </div>
            </div>
          </div>
        </section>

        <!-- 3. PRÓXIMO MANTENIMIENTO -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--green">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            </div>
            <h3>Próximo Mantenimiento</h3>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="proximo_km">Próximo km</label>
              <input type="number" name="proximo_km" id="proximo_km" min="0" placeholder="Ej: 50000">
              <span class="form-group__hint">Km en el que se recomienda el próximo servicio.</span>
            </div>
            <div class="form-group">
              <label for="proxima_fecha">Próxima fecha</label>
              <input type="date" name="proxima_fecha" id="proxima_fecha">
            </div>
          </div>
        </section>

        <!-- 4. DETALLE DE REPUESTOS -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--slate">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/></svg>
            </div>
            <h3>Detalle de Repuestos</h3>
          </div>

          <div class="repuestos-header">
            <span>Repuesto / Descripción</span>
            <span>Cant.</span>
            <span>Costo unit. ($)</span>
            <span></span>
          </div>

          <div id="repuestos-container">
            <div class="repuesto-fila" data-fila="1">
              <select name="id_repuesto[]">
                <option value="">— Seleccionar —</option>
                <option value="1">Filtro de aceite</option>
                <option value="2">Filtro de aire</option>
                <option value="3">Filtro de combustible</option>
                <option value="4">Aceite motor 15W40</option>
                <option value="5">Pastillas de freno</option>
                <option value="6">Disco de freno</option>
                <option value="7">Correa de distribución</option>
                <option value="8">Bujías</option>
                <option value="99">Otro (manual)</option>
              </select>
              <input type="number" name="cantidad[]" min="1" value="1" placeholder="1">
              <input type="number" name="costo_unitario[]" min="0" step="0.01" placeholder="0.00">
              <button type="button" class="btn-remove-fila" aria-label="Eliminar fila" onclick="eliminarFila(this)">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </button>
            </div>
          </div>

          <div class="repuestos-footer">
            <button type="button" class="btn-add-repuesto" id="btn-add-repuesto">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"/></svg>
              Agregar repuesto
            </button>
            <div class="costo-total-display">
              <span>Subtotal repuestos:</span>
              <strong id="subtotal-repuestos">$0.00</strong>
            </div>
          </div>
        </section>

        <!-- 5. COSTOS -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--green">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.077 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.077-2.354-1.253V5z" clip-rule="evenodd"/></svg>
            </div>
            <h3>Costos</h3>
          </div>

          <div class="form-group">
            <label for="costo_total">Costo total del servicio ($)</label>
            <input type="number" name="costo_total" id="costo_total" min="0" step="0.01" placeholder="0.00">
            <span class="form-group__hint">Incluye mano de obra + repuestos. Puede dejarse vacío si se calcula automáticamente.</span>
          </div>
        </section>

        <!-- 6. DESCRIPCIÓN Y OBSERVACIONES — ancho completo -->
        <section class="form-section form-col-full">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--slate">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 000 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/></svg>
            </div>
            <h3>Descripción y Observaciones</h3>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="descripcion">Descripción del trabajo realizado</label>
              <textarea name="descripcion" id="descripcion" class="obs-textarea" placeholder="Detalle las tareas realizadas, piezas inspeccionadas, procedimientos aplicados…"></textarea>
            </div>
            <div class="form-group">
              <label for="observaciones">Observaciones adicionales</label>
              <textarea name="observaciones" id="observaciones" class="obs-textarea" placeholder="Notas internas, recomendaciones para el próximo servicio, anomalías detectadas…"></textarea>
            </div>
          </div>
        </section>

        <!-- ACCIONES -->
        <div class="acciones form-col-full">
          <button type="button" class="boton-secundario" onclick="history.back()">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
            Volver
          </button>
          <button type="submit" class="boton-primario">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Guardar Mantenimiento
          </button>
        </div>

      </form>

    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="app-footer">
      <p class="app-footer__copy">* Campos obligatorios &nbsp;|&nbsp; &copy; 2025 &mdash; Ficha Tecnica · Municipalidad</p>
    </footer>

  </div><!-- /app-wrapper -->

  <script>
  /* ── Sidebar toggle ────────────────────────────────── */
const sidebar      = document.getElementById('sidebar');
const overlay      = document.getElementById('sidebar-overlay');
const menuToggle   = document.getElementById('menu-toggle');
const sidebarClose = document.getElementById('sidebar-close');

function openSidebar() {
  sidebar.classList.add('sidebar--open');
  overlay.classList.add('sidebar-overlay--visible');
  menuToggle.setAttribute('aria-expanded', 'true');
  document.body.style.overflow = 'hidden';
}
function closeSidebar() {
  sidebar.classList.remove('sidebar--open');
  overlay.classList.remove('sidebar-overlay--visible');
  menuToggle.setAttribute('aria-expanded', 'false');
  document.body.style.overflow = '';
}

menuToggle  .addEventListener('click', openSidebar);
sidebarClose.addEventListener('click', closeSidebar);
overlay     .addEventListener('click', closeSidebar);

/* ── Acordeón submenús ─────────────────────────────── */
document.querySelectorAll('.sidebar__menu-item--expandable > .sidebar__menu-link')
  .forEach(link => {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      const item = this.closest('.sidebar__menu-item--expandable');
      item.classList.toggle('sidebar__menu-item--open');
    });
  });

/* Abrir el submenú activo al cargar */
document.querySelectorAll('.sidebar__submenu-link--active').forEach(active => {
  const item = active.closest('.sidebar__menu-item--expandable');
  if (item) item.classList.add('sidebar__menu-item--open');
});

  /* ============================================================
     VEHICLE CARD — mostrar resumen al seleccionar vehículo
  ============================================================ */
  const vehicleSelect = document.getElementById('id_vehiculo');
  const vehicleCard   = document.getElementById('vehicle-card');
  const vcPatente     = document.getElementById('vc-patente');
  const vcDetalle     = document.getElementById('vc-detalle');
  const vcKm          = document.getElementById('vc-km');

  vehicleSelect.addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    if (!this.value) { vehicleCard.classList.remove('visible'); return; }
    vcPatente.textContent = opt.dataset.patente || '—';
    vcDetalle.textContent = opt.dataset.detalle || '—';
    vcKm.textContent      = opt.dataset.km ? Number(opt.dataset.km).toLocaleString('es-AR') + ' km' : '— km';
    vehicleCard.classList.add('visible');
    const kmInput = document.getElementById('km_servicio');
    if (opt.dataset.km && !kmInput.value) kmInput.value = opt.dataset.km;
  });

  /* ============================================================
     ESTADO — punto de color dinámico
  ============================================================ */
  const estadoSelect = document.getElementById('estado');
  const estadoDot    = document.getElementById('estado-dot');
  const estadoColors = { 'Realizado':'#16a34a', 'En proceso':'#f59e0b', 'Pendiente':'#94a3b8', 'Cancelado':'#dc2626' };

  function updateEstadoDot() {
    estadoDot.style.background = estadoColors[estadoSelect.value] || '#94a3b8';
  }
  estadoSelect.addEventListener('change', updateEstadoDot);
  updateEstadoDot();

  /* ============================================================
     REPUESTOS — agregar / eliminar filas + calcular subtotal
  ============================================================ */
  let filaCount = 1;

  const repuestosOpciones = `
  <option value="">— Seleccionar —</option>

  <% repuestos.forEach(repuesto => { %>
    <option value="<%= repuesto.id_repuesto %>">
      <%= repuesto.nombre %>
    </option>
  <% }) %>
`;

  document.getElementById('btn-add-repuesto').addEventListener('click', function () {
    filaCount++;
    const container = document.getElementById('repuestos-container');
    const fila = document.createElement('div');
    fila.className  = 'repuesto-fila';
    fila.dataset.fila = filaCount;
    fila.innerHTML = `
      <select name="id_repuesto[]">${repuestosOpciones}</select>
      <input type="number" name="cantidad[]" min="1" value="1" placeholder="1">
      <input type="number" name="costo_unitario[]" min="0" step="0.01" placeholder="0.00">
      <button type="button" class="btn-remove-fila" aria-label="Eliminar fila" onclick="eliminarFila(this)">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
      </button>
    `;
    fila.querySelectorAll('input[type=number]').forEach(i => i.addEventListener('input', calcularSubtotal));
    container.appendChild(fila);
    calcularSubtotal();
  });

  function eliminarFila(btn) {
    if (document.querySelectorAll('.repuesto-fila').length <= 1) return;
    btn.closest('.repuesto-fila').remove();
    calcularSubtotal();
  }

  function calcularSubtotal() {
    let total = 0;
    document.querySelectorAll('.repuesto-fila').forEach(fila => {
      const cant  = parseFloat(fila.querySelector('input[name="cantidad[]"]').value)       || 0;
      const costo = parseFloat(fila.querySelector('input[name="costo_unitario[]"]').value) || 0;
      total += cant * costo;
    });
    document.getElementById('subtotal-repuestos').textContent =
      '$' + total.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  document.querySelectorAll('.repuesto-fila input[type=number]').forEach(i => i.addEventListener('input', calcularSubtotal));

  if (vehicleSelect.value) {
    vehicleSelect.dispatchEvent(new Event('change'));
}
  </script>

</body>
</html>
