<header class="topbar">
  <button class="topbar__menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6"  x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <div class="topbar__mobile-brand" aria-hidden="true">
    <img class="imglogosidebarcel" src="/images/header/images-removebg-preview (1).png" alt="">
    <span>Ficha Tecnica</span>
  </div>

  <div class="topbar__actions">
    <button class="topbar__notification-btn" aria-label="Notificaciones (3 sin leer)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
      <span class="topbar__notification-dot" aria-label="3 notificaciones">3</span>
    </button>
    
    <div class="topbar__user" role="button" tabindex="0">
      <% if (usuarioLocal) { %>
        <div style="text-align: right; margin-right: 8px; line-height: 1.2;">
          <span class="topbar__user-name" style="display: block; font-weight: bold;"><%= usuarioLocal.nombre %> <%= usuarioLocal.apellido %></span>
          <span style="font-size: 12px; color: #94a3b8;"><%= usuarioLocal.rol %></span>
        </div>
        <a href="/CerrarSesion" style="background-color: #ef4444; color: white; padding: 6px 12px; border-radius: 6px; font-size: 14px; font-weight: bold; text-decoration: none;">Salir</a>
      <% } else { %>
        <svg class="topbar__user-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
        <span class="topbar__user-name">Usuario</span>
      <% } %>
    </div>
  </div>
</header>