<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Asignar Préstamo - Gestión Industrial</title>
  <link rel="stylesheet" href="/css/CargaFichaVehiculo.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ===================== SIDEBAR ===================== -->
  <%- include('./partials/sidebar') %>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper" id="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <%- include('./partials/topbar') %>

    <main class="main-content">

      <div class="page-header">
        <div>
          <h2 class="page-title">Formulario de Préstamo</h2>
          <p class="page-subtitle">Asignar activo a un colaborador externo o interno.</p>
        </div>
      </div>

      <form class="form" action="/Tools/Prestamo" method="post">

        <input type="hidden" name="id_herramienta" value="<%= herramienta.id_herramienta %>">

        <section class="form-section" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
          <h3>Activo Seleccionado</h3>
          <div class="form-row">
            <div class="form-group">
              <label>Código y Nombre</label>
              <input type="text" class="form-control" value="<%= herramienta.codigo_activo %> - <%= herramienta.nombre %>" disabled>
            </div>
            <div class="form-group">
              <label>Estado Actual</label>
              <input type="text" class="form-control" value="<%= herramienta.estado %>" disabled>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h3>Detalles de Asignación</h3>

          <div class="form-group">
            <label>Persona destino / Operario</label>
            <select name="nombre_operario" required>
              <option value="">Seleccione Operario</option>
              <% if (typeof operarios !== 'undefined' && operarios.length > 0) { %>
                <% operarios.forEach(o => { %>
                  <option value="<%= o.nombre %>"><%= o.nombre %></option>
                <% }) %>
              <% } else { %>
                <option value="">No hay operarios disponibles (Registra uno en Ajustes)</option>
              <% } %>
            </select>
          </div>

          <div class="form-group">
            <label>Sector destino</label>
            <select name="sector_destino" required>
              <option value="">Seleccione Sector</option>
              <% if (typeof sectores !== 'undefined' && sectores.length > 0) { %>
                <% sectores.forEach(s => { %>
                  <option value="<%= s.nombre %>"><%= s.nombre %></option>
                <% }) %>
              <% } else { %>
                <option value="Obras Públicas">Obras Públicas</option>
                <option value="Mantenimiento Urbano">Mantenimiento Urbano</option>
                <option value="Espacios Verdes">Espacios Verdes</option>
                <option value="Taller Central">Taller Central</option>
              <% } %>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Fecha de préstamo</label>
              <input name="fecha_salida" type="date" required>
            </div>
            <div class="form-group">
              <label>Fecha devolución esperada</label>
              <input name="fecha_devolucion_estimada" type="date">
            </div>
          </div>
        </section>

        <section class="form-section">
          <div style="background-color: #fffbeb; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 4px;">
            <h4 style="color: #b45309; margin-top: 0; margin-bottom: 5px;">⚠️ Recordatorio de Préstamo</h4>
            <p style="color: #92400e; margin: 0; font-size: 0.9em;">Al completar este formulario, se generará el registro del préstamo y se actualizará automáticamente el estado de la herramienta a "En uso".</p>
          </div>
        </section>

        <div class="acciones">
          <button type="button" class="boton-secundario" onclick="window.history.back();">Cancelar</button>
          <button type="submit" class="boton-primario">Confirmar Préstamo</button>
        </div>

      </form>

    </main>

    <footer class="app-footer">
      <p class="app-footer__copy">&copy; 2026 &mdash; Gestión Industrial</p>
    </footer>

  </div>

  <script src="/js/sidebar.js"></script>

</body>
</html>