<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/inicio_Sesion.css">
</head>
<body>
    <div class="box_datos">
        <h1 class="inicio_titulo">Iniciar Sesión</h1>
        <form action="/InicioSesion" method="post">
            <label class="usuario" for="Usuario">Usuario</label>
            <input id="Usuario" name="Usuario" class="input_usuario" type="text" placeholder="Ingresa tu usuario" required>
            
            <label class="contraseña" for="Contrasena">Contraseña</label>
            <input id="Contrasena" name="Contrasena" class="input_contraseña" type="password" placeholder="Ingresa tu contraseña" required>
            
            <input class="submit" type="submit" value="Ingresar">
         </form>
    </div>
</body>
</html>