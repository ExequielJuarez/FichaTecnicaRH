    <!-- ===================== MAIN ===================== -->
    <main class="main-content">

      <div class="page-header">
        <div>
          <h2 class="page-title">Cargar Vehículo</h2>
          <p class="page-subtitle">Complete todos los datos del vehículo.</p>
        </div>
        
      </div>

      <form class="form" action="/CargaVehiculo" method="post">

  <section class="form-section">
    <h3>Información Básica</h3>

    <div class="form-group">
      <label>Patente</label>
      <input name="patente" type="text" placeholder="Ej: AB123CD">
    </div>

    <div class="form-group">
      <label>Tipo de Vehículo</label>
      <select name="id_tipo">
        <option value="">Seleccione tipo</option>
        <!-- IMPORTANTE: ahora son IDs -->
        <option value="1">Camioneta</option>
        <option value="2">Camión</option>
        <option value="3">Maquinaria Pesada</option>
      </select>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Marca</label>
        <input name="marca" type="text">
      </div>
      <div class="form-group">
        <label>Modelo</label>
        <input name="modelo" type="text">
      </div>
    </div>

    <div class="form-group small">
      <label>Año</label>
      <!-- CAMBIO: ano → anio -->
      <input name="anio" type="number">
    </div>
  </section>

  <section class="form-section">
    <h3>Información Técnica</h3>

    <div class="form-group">
      <label>Número de Chasis</label>
      <input name="chasis" type="text">
    </div>

    <div class="form-group">
      <label>Número de Motor</label>
      <input name="num_motor" type="text">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Combustible</label>
        <!-- le agrego name por si después lo usás -->
        <select name="combustible">
          <option value="">Seleccionar</option>
          <option>Diesel</option>
          <option>Nafta</option>
          <option>Electrico</option>
        </select>
      </div>

      <div class="form-group">
        <label>Transmisión</label>
        <select name="transmision">
          <option value="">Seleccionar</option>
          <!-- SIN tilde (IMPORTANTE por ENUM) -->
          <option value="Manual">Manual</option>
          <option value="Automatica">Automatica</option>
        </select>
      </div>
    </div>
  </section>

  <section class="form-section">
    <h3>Estado y Ubicación</h3>

    <div class="form-row">
      <div class="form-group">
        <label>Estado</label>
        <select name="estado_actual">
          <!-- EXACTO como en ENUM -->
          <option value="Disponible">Disponible</option>
          <option value="En uso">En uso</option>
          <option value="En mantenimiento">En mantenimiento</option>
          <option value="Baja">Baja</option>
        </select>
      </div>

      <div class="form-group">
        <label>Kilometraje</label>
        <input name="km_actual" type="number">
      </div>
    </div>

    <div class="form-group">
      <label>Distrito</label>
      <select name="distrito">
        <option value="Centro">Centro</option>
        <option value="Norte">Norte</option>
        <option value="Sur">Sur</option>
      </select>
    </div>

    <div class="form-group">
      <label>Observaciones</label>
      <!-- LE FALTABA name -->
      <textarea name="observaciones"></textarea>
    </div>
  </section>

  <section class="form-section">
    <h3>Fechas</h3>

    <div class="form-row">
      <div class="form-group">
        <label>Fecha de Alta</label>
        <input name="fecha_alta" type="date">
      </div>
  </section>

  <!-- <section class="form-section">
    <h3>Imagen del Vehículo</h3>

    <div class="upload-box">
      <label for="imagen">Subir imagen</label>
      <input type="file" id="imagen" name="imagen">
    </div>

    <div id="preview">
      No hay imagen
    </div>
  </section> -->


  <div class="acciones">
    <!-- IMPORTANTE: este botón no debe enviar -->
    <button type="button" class="boton-secundario">Volver</button>
  
    <button type="submit" class="boton-primario">
      Guardar Vehículo
    </button>
  </div>

  

</form>



    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="app-footer">
      <p class="app-footer__copy">* Campos obligatorios &nbsp;|&nbsp; &copy; 2025 &mdash; Ficha Tecnica</p>
    </footer>

  </div><!-- /app-wrapper -->

  <script>
    /* ============================================================
       SIDEBAR TOGGLE — mobile / tablet
    ============================================================ */
    const sidebar      = document.getElementById('sidebar');
    const overlay      = document.getElementById('sidebar-overlay');
    const menuToggle   = document.getElementById('menu-toggle');
    const sidebarClose = document.getElementById('sidebar-close');

    function openSidebar() {
      sidebar.classList.add('sidebar--open');
      overlay.classList.add('sidebar-overlay--visible');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('sidebar--open');
      overlay.classList.remove('sidebar-overlay--visible');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    /* ── Acordeón submenús ─────────────────────────────── */
    document.querySelectorAll('.sidebar__menu-item--expandable > .sidebar__menu-link')
      .forEach(link => {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          const item = this.closest('.sidebar__menu-item--expandable');
          item.classList.toggle('sidebar__menu-item--open');
        });
      });

    /* Abrir el submenú activo al cargar */
    document.querySelectorAll('.sidebar__submenu-link--active').forEach(active => {
      const item = active.closest('.sidebar__menu-item--expandable');
      if (item) item.classList.add('sidebar__menu-item--open');
    });

    menuToggle.addEventListener('click', openSidebar);
    sidebarClose.addEventListener('click', closeSidebar);
    overlay.addEventListener('click', closeSidebar);
  </script>

</body>
