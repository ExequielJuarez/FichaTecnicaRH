            <input type="text">

            <label for="">Año</label>
            <input type="date">

            <label for="">Km actual</label>
            <input type="text">

            <label for="">Tipo de vehículo</label>
            <input type="text">

            <label for="">Estado</label>
            <input type="text">

            <section class="contButtons">
                
            <button class="guardarV">Guardar Vehiculo</button>
            <button class="limpiarV">Limpiar</button>

            </section>
            
        </section>

        

