            <i class="fa-solid fa-bars "></i>
        </section>

        <section class="contLogo">
            <img class="imgLogo" src="/images/header/images-removebg-preview (1).png" alt="">
        </section>

        <section class="iconUser2">
            <i class="fa-regular fa-user "></i>
        </section>

        <div class="contOptions">
            <a class="OptionsHeader" href="">Listado Vehiculos</a>
            <a class="OptionsHeader" href="">Cargar Vehiculos</a>
            <a class="OptionsHeader" href="">Cargar Chofer</a>
            <a class="OptionsHeader" href="">Cargar Ficha</a>
        </div>

        <div class="contOptions2" id="contOptions2">
            <section id="btn2" class="iconX">
                <i class="fa-solid fa-x"></i>
            </section>
            <a class="OptionsHeader2" href="">Listado V</a>
            <a class="OptionsHeader2" href="">Cargar V</a>
            <a class="OptionsHeader2" href="">Cargar Chofer</a>
            <a class="OptionsHeader2" href="">Cargar Ficha</a>
