<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cargar Herramienta - Gestión Industrial</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-bg:           #f1f5f9;
      --color-surface:      #ffffff;
      --color-border:       #e2e8f0;
      --color-border-light: #f1f5f9;
      --color-sidebar-bg:          #0f172a;
      --color-sidebar-text:        #94a3b8;
      --color-sidebar-text-hover:  #f1f5f9;
      --color-sidebar-active-bg:   rgba(255 255 255 / 0.08);
      --color-sidebar-active-text: #ffffff;
      --color-primary:       #1d4ed8;
      --color-primary-hover: #1e40af;
      --color-amber:      #f59e0b;
      --color-text-primary:   #0f172a;
      --color-text-secondary: #475569;
      --color-text-muted:     #94a3b8;
      --sidebar-width:  220px;
      --topbar-height:  56px;
      --radius-sm:   4px;
      --radius-md:   8px;
      --radius-lg:   12px;
      --radius-full: 9999px;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.07);
      --shadow-lg: 0 10px 25px -3px rgb(0 0 0 / 0.15), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      --font-sans: 'DM Sans', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      font-size: 14px;
      background: var(--color-bg);
      color: var(--color-text-primary);
      min-height: 100vh;
      display: flex;
      line-height: 1.5;
    }
    a { text-decoration: none; color: inherit; }
    ul, ol { list-style: none; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; font-size: inherit; }
    svg { display: block; flex-shrink: 0; }

    /* OVERLAY */
    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(0 0 0 / 0.45);
      z-index: 90;
      opacity: 0;
      transition: opacity 0.25s;
    }
    .sidebar-overlay--visible { opacity: 1; }

    /* SIDEBAR */
    .sidebar {
      position: fixed;
      top: 0; left: 0;
      width: var(--sidebar-width);
      height: 100vh;
      background-color: var(--color-sidebar-bg);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      z-index: 100;
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sidebar__brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px;
      border-bottom: 1px solid rgba(255 255 255 / 0.07);
      flex-shrink: 0;
    }
    .sidebar__logo { flex-shrink: 0; }
    .imglogosidebar    { width: 100%; height: 50px; }
    .imglogosidebarcel { width: 25%; height: 40px; }
    .sidebar__brand-name {
      display: block;
      font-size: 13px; font-weight: 700; color: #fff; line-height: 1.2;
    }
    .sidebar__brand-sub {
      display: block;
      font-size: 11px; color: var(--color-sidebar-text);
    }
    .sidebar__close-btn {
      display: none;
      margin-left: auto;
      width: 28px; height: 28px;
      align-items: center; justify-content: center;
      border-radius: var(--radius-md);
      color: var(--color-sidebar-text);
      flex-shrink: 0;
      transition: background 0.15s, color 0.15s;
    }
    .sidebar__close-btn svg { width: 16px; height: 16px; }
    .sidebar__close-btn:hover { background-color: rgba(255 255 255 / 0.08); color: #fff; }

    .sidebar__nav { padding: 16px 0 24px; flex: 1; }
    .sidebar__nav-label {
      display: block;
      padding: 0 16px 8px;
      font-size: 10px; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--color-sidebar-text);
    }
    .sidebar__menu { display: flex; flex-direction: column; gap: 1px; }
    .sidebar__menu-link {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 16px;
      color: var(--color-sidebar-text);
      font-size: 13px; font-weight: 500;
      transition: background 0.15s, color 0.15s;
    }
    .sidebar__menu-link:hover { background-color: rgba(255 255 255 / 0.05); color: var(--color-sidebar-text-hover); }
    .sidebar__menu-link--active { background-color: var(--color-sidebar-active-bg); color: var(--color-sidebar-active-text); }
    .sidebar__menu-icon    { width: 16px; height: 16px; flex-shrink: 0; opacity: 0.8; }
    .sidebar__menu-chevron {
      width: 14px; height: 14px; margin-left: auto;
      transition: transform 0.25s ease;
    }
    .sidebar__menu-item--open .sidebar__menu-chevron { transform: rotate(180deg); }
    .sidebar__badge {
      margin-left: auto;
      background-color: #dc2626;
      color: #fff; font-size: 10px; font-weight: 700;
      padding: 1px 6px; border-radius: var(--radius-full);
      min-width: 18px; text-align: center;
    }
    .sidebar__submenu {
      padding-left: 40px;
      padding-bottom: 4px;
      display: none;
      flex-direction: column;
      gap: 1px;
    }
    .sidebar__menu-item--open .sidebar__submenu { display: flex; }
    .sidebar__submenu-link {
      display: block;
      padding: 7px 12px;
      color: var(--color-sidebar-text); font-size: 12.5px;
      border-radius: var(--radius-sm);
      transition: color 0.15s, background 0.15s;
    }
    .sidebar__submenu-link:hover { color: var(--color-sidebar-text-hover); background-color: rgba(255 255 255 / 0.04); }
    .sidebar__submenu-link--active { color: var(--color-amber); font-weight: 600; }
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-track { background: transparent; }
    .sidebar::-webkit-scrollbar-thumb { background-color: rgba(255 255 255 / 0.1); border-radius: var(--radius-full); }

    /* APP WRAPPER */
    .app-wrapper {
      display: flex;
      flex-direction: column;
      flex: 1;
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      transition: margin-left 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* TOPBAR */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      height: var(--topbar-height);
      background-color: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 8px;
      box-shadow: var(--shadow-sm);
    }
    .topbar__menu-toggle {
      display: none;
      width: 36px; height: 36px;
      align-items: center; justify-content: center;
      border-radius: var(--radius-md);
      color: var(--color-text-secondary);
      flex-shrink: 0;
      transition: background 0.15s;
    }
    .topbar__menu-toggle:hover { background-color: var(--color-bg); }
    .topbar__menu-toggle svg   { width: 20px; height: 20px; }
    .topbar__mobile-brand {
      display: none;
      align-items: center;
      gap: 8px;
      flex: 1;
      font-size: 13px;
      font-weight: 700;
      color: var(--color-text-primary);
    }
    .topbar__actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
    .topbar__notification-btn {
      position: relative;
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      border-radius: var(--radius-md);
      color: var(--color-text-secondary);
      transition: background 0.15s;
    }
    .topbar__notification-btn svg { width: 18px; height: 18px; }
    .topbar__notification-btn:hover { background-color: var(--color-bg); }
    .topbar__notification-dot {
      position: absolute;
      top: 6px; right: 6px;
      width: 16px; height: 16px;
      background-color: #dc2626;
      color: #fff; font-size: 9px; font-weight: 700;
      border-radius: var(--radius-full);
      display: flex; align-items: center; justify-content: center;
      border: 2px solid var(--color-surface);
    }
    .topbar__user {
      display: flex; align-items: center; gap: 6px;
      padding: 6px 10px;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: background 0.15s;
    }
    .topbar__user:hover { background-color: var(--color-bg); }
    .topbar__user-icon  { width: 18px; height: 18px; color: var(--color-text-secondary); }
    .topbar__user-name  { font-size: 13px; font-weight: 500; color: var(--color-text-primary); }
    .topbar__user-chevron { width: 14px; height: 14px; color: var(--color-text-muted); }

    /* MAIN */
    .main-content { flex: 1; padding: 24px; overflow-y: auto; }
    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .page-title { font-size: 20px; font-weight: 700; color: var(--color-text-primary); line-height: 1.2; }
    .page-subtitle { font-size: 13px; color: var(--color-text-secondary); margin-top: 4px; }

    /* FORM */
    .form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .form-section {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }
    .form-section h3 {
      font-size: 13px; font-weight: 700;
      color: var(--color-text-primary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding-bottom: 12px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--color-border);
    }
    .form-group { display: flex; flex-direction: column; margin-bottom: 12px; }
    .form-group:last-child { margin-bottom: 0; }
    .form-group label { font-size: 12px; font-weight: 600; color: var(--color-text-secondary); margin-bottom: 5px; }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 8px 10px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--color-text-primary);
      background-color: var(--color-surface);
      transition: border-color 0.15s, box-shadow 0.15s;
      width: 100%;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
    }
    .form-group textarea { resize: vertical; min-height: 80px; }
    .form-row { display: flex; gap: 12px; }
    .form-row .form-group { flex: 1; }
    .form-group.small { width: 120px; }

    /* UPLOAD */
    .upload-box {
      border: 2px dashed var(--color-border);
      padding: 24px;
      text-align: center;
      border-radius: var(--radius-md);
      margin-bottom: 10px;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
    }
    .upload-box:hover { border-color: var(--color-primary); background-color: #eff6ff; }
    .upload-box label { font-size: 13px; font-weight: 600; color: var(--color-primary); cursor: pointer; }
    #preview {
      border: 1px solid var(--color-border);
      padding: 16px;
      text-align: center;
      border-radius: var(--radius-md);
      font-size: 13px;
      color: var(--color-text-muted);
      min-height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ACCIONES */
    .acciones { display: flex; gap: 8px; flex-wrap: wrap; }
    .boton-primario {
      padding: 9px 18px;
      background-color: var(--color-primary);
      color: #fff;
      border-radius: var(--radius-md);
      font-size: 13px; font-weight: 600;
      transition: background 0.15s;
    }
    .boton-primario:hover { background-color: var(--color-primary-hover); }
    .boton-secundario {
      padding: 9px 18px;
      background-color: var(--color-surface);
      color: var(--color-text-secondary);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 13px; font-weight: 600;
      transition: background 0.15s;
    }
    .boton-secundario:hover { background-color: var(--color-bg); }

    /* FOOTER */
    .app-footer { padding: 14px 24px; border-top: 1px solid var(--color-border); background-color: var(--color-surface); }
    .app-footer__copy { font-size: 12px; color: var(--color-text-muted); }

    /* RESPONSIVE TABLET */
    @media (max-width: 1100px) {
      .form { grid-template-columns: 1fr; }
    }

    @media (max-width: 900px) {
      .sidebar-overlay { display: block; pointer-events: none; }
      .sidebar-overlay--visible { pointer-events: all; }
      .sidebar { transform: translateX(-100%); box-shadow: var(--shadow-lg); }
      .sidebar--open { transform: translateX(0); }
      .sidebar__close-btn { display: flex; }
      .app-wrapper { margin-left: 0; }
      .topbar__menu-toggle  { display: flex; }
      .topbar__mobile-brand { display: flex; }
      .page-header { flex-direction: column; align-items: flex-start; }
      .main-content { padding: 16px; }
      .topbar__user-name { display: none; }
    }

    @media (max-width: 480px) {
      .main-content { padding: 12px; }
      .form-row { flex-direction: column; gap: 0; }
      .form-group.small { width: 100%; }
      .acciones { width: 100%; justify-content: stretch; }
      .boton-primario, .boton-secundario { flex: 1; text-align: center; }
    }
  </style>
</head>
