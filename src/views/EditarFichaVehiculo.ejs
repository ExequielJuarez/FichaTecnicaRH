  <!-- ===================== SIDEBAR ===================== -->
  <aside class="sidebar" id="sidebar" aria-label="Menú de navegación">

    <div class="sidebar__brand">
      <div class="sidebar__logo">
        <img class="imglogosidebar" src="/images/header/images-removebg-preview (1).png" alt="">
      </div>
      <div class="sidebar__brand-text">
        <span class="sidebar__brand-name">Ficha Tecnica</span>
        <span class="sidebar__brand-sub">Municipalidad</span>
      </div>
      <button class="sidebar__close-btn" id="sidebar-close" aria-label="Cerrar menú">
        <svg viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>

    <nav class="sidebar__nav" aria-label="Navegación principal">
      <span class="sidebar__nav-label">Menú Principal</span>

      <ul class="sidebar__menu">

        <li class="sidebar__menu-item">
          <a href="/" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
            Inicio
          </a>
        </li>
      
        <li class="sidebar__menu-item sidebar__menu-item--expandable">
          <a href="#" class="sidebar__menu-link sidebar__menu-link--active">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
            Vehículos
            <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </a>
          <ul class="sidebar__submenu">
            <li><a href="/Vehicles" class="sidebar__submenu-link sidebar__submenu-link--active">Listado de vehículos</a></li>
            <li><a href="/CargaVehiculo" class="sidebar__submenu-link">Agregar vehículo</a></li>
          </ul>
        </li>
      
        <li class="sidebar__menu-item sidebar__menu-item--expandable">
          <a href="#" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            Choferes
            <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </a>
          <ul class="sidebar__submenu">
            <li><a href="/Choferes" class="sidebar__submenu-link">Listado de choferes</a></li>
            <li><a href="/Choferes/carga" class="sidebar__submenu-link">Agregar chofer</a></li>
          </ul>
        </li>
      
        <li class="sidebar__menu-item sidebar__menu-item--expandable">
          <a href="#" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
            Mantenimientos
            <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </a>
          <ul class="sidebar__submenu">
            <li><a href="/Mantenimientos" class="sidebar__submenu-link">Listado</a></li>
            <li><a href="/Mantenimientos/carga" class="sidebar__submenu-link">Agregar mantenimiento</a></li>
          </ul>
        </li>
      
        <li class="sidebar__menu-item sidebar__menu-item--expandable">
          <a href="#" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6.672 1.911a1 1 0 10-1.932.518l.259.966a1 1 0 001.932-.518l-.26-.966zM2.429 4.74a1 1 0 10-.517 1.932l.966.259a1 1 0 00.517-1.932l-.966-.26zm8.814-.569a1 1 0 00-1.415-1.414l-.707.707a1 1 0 101.415 1.415l.707-.708zm-7.071 7.072l.707-.707A1 1 0 003.465 9.12l-.708.707a1 1 0 001.415 1.415zm3.2-5.171a1 1 0 00-1.3 1.3l4 10a1 1 0 001.823.075l1.38-2.759 3.018 3.02a1 1 0 001.414-1.415l-3.019-3.02 2.76-1.379a1 1 0 00-.076-1.822l-10-4z" clip-rule="evenodd"/></svg>
            Herramientas
            <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </a>
          <ul class="sidebar__submenu">
            <li><a href="/Tools" class="sidebar__submenu-link">Inventario</a></li>
            <li><a href="/Tools/carga" class="sidebar__submenu-link">Carga herramienta</a></li>
            <li><a href="/Tools/prestamos" class="sidebar__submenu-link">Préstamos</a></li>
            <li><a href="/Tools/ajustes" class="sidebar__submenu-link">Ajustes</a></li>
          </ul>
        </li>
      
        <li class="sidebar__menu-item">
          <a href="/Alertas" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
            Alertas
            <span class="sidebar__badge">5</span>
          </a>
        </li>
      
        <li class="sidebar__menu-item">
          <a href="#" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            Usuarios
          </a>
        </li>
      
        <li class="sidebar__menu-item">
          <a href="#" class="sidebar__menu-link">
            <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"/></svg>
            Auditoría
          </a>
        </li>
      
      </ul>
    </nav>
  </aside>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <header class="topbar">
      <button class="topbar__menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6"  x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <div class="topbar__mobile-brand" aria-hidden="true">
        <img class="imglogosidebarcel" src="/images/header/images-removebg-preview (1).png" alt="">
        <span>Ficha Tecnica</span>
      </div>

      <div class="topbar__actions">
        <button class="topbar__notification-btn" aria-label="Notificaciones">
          <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
          <span class="topbar__notification-dot" aria-label="3 notificaciones">3</span>
        </button>
        <div class="topbar__user" role="button" tabindex="0">
          <svg class="topbar__user-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
          <span class="topbar__user-name">Administrador</span>
          <svg class="topbar__user-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        </div>
      </div>
    </header>

    <!-- ===================== MAIN ===================== -->
    <main class="main-content">

      <div class="page-header">
        <div>
          <h2 class="page-title">Editar Vehículo</h2>
          <p class="page-subtitle">Modifica los datos del vehículo seleccionado.</p>
        </div>

        <!-- Botón acceso rápido a Registrar Mantenimiento -->
        <a href="/Mantenimientos/carga/<%= vehiculo.id_vehiculo %>" class="boton-secundario" style="display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;">
          <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;flex-shrink:0;">
            <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
          </svg>
          Registrar Mantenimiento
        </a>
      </div>

      <%# La ruta POST apunta a /Vehicles/Editar/:id %>
      <form class="form" action="/Vehicles/Editar/<%= vehiculo.id_vehiculo %>" method="post">

        <!-- =================== INFORMACIÓN BÁSICA =================== -->
        <section class="form-section">
          <h3>Información Básica</h3>

          <div class="form-group">
            <label>Patente</label>
            <input name="patente" type="text" placeholder="Ej: AB123CD" value="<%= vehiculo.patente %>" required>
          </div>

          <div class="form-group">
            <label>Tipo de Vehículo</label>
            <select name="id_tipo" required>
              <option value="">Seleccione tipo</option>
              <option value="1" <%= vehiculo.id_tipo === 1 ? 'selected' : '' %>>Camioneta</option>
              <option value="2" <%= vehiculo.id_tipo === 2 ? 'selected' : '' %>>Camión</option>
              <option value="3" <%= vehiculo.id_tipo === 3 ? 'selected' : '' %>>Maquinaria Pesada</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Marca</label>
              <input name="marca" type="text" value="<%= vehiculo.marca %>">
            </div>
            <div class="form-group">
              <label>Modelo</label>
              <input name="modelo" type="text" value="<%= vehiculo.modelo %>">
            </div>
          </div>

          <div class="form-group small">
            <label>Año</label>
            <input name="anio" type="number" value="<%= vehiculo.anio %>">
          </div>
        </section>

        <!-- =================== INFORMACIÓN TÉCNICA =================== -->
        <section class="form-section">
          <h3>Información Técnica</h3>

          <div class="form-group">
            <label>Número de Chasis</label>
            <input name="chasis" type="text" value="<%= vehiculo.chasis || '' %>">
          </div>

          <div class="form-group">
            <label>Número de Motor</label>
            <input name="num_motor" type="text" value="<%= vehiculo.num_motor || '' %>">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Combustible</label>
              <select name="combustible">
                <option value="">Seleccionar</option>
                <option value="Diesel"    <%= vehiculo.combustible === 'Diesel'    ? 'selected' : '' %>>Diesel</option>
                <option value="Nafta"     <%= vehiculo.combustible === 'Nafta'     ? 'selected' : '' %>>Nafta</option>
                <option value="Electrico" <%= vehiculo.combustible === 'Electrico' ? 'selected' : '' %>>Electrico</option>
              </select>
            </div>

            <div class="form-group">
              <label>Transmisión</label>
              <select name="transmision">
                <option value="">Seleccionar</option>
                <option value="Manual"     <%= vehiculo.transmision === 'Manual'     ? 'selected' : '' %>>Manual</option>
                <option value="Automatica" <%= vehiculo.transmision === 'Automatica' ? 'selected' : '' %>>Automatica</option>
              </select>
            </div>
          </div>
        </section>

        <!-- =================== ESTADO Y UBICACIÓN =================== -->
        <section class="form-section">
          <h3>Estado y Ubicación</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Estado</label>
              <select name="estado_actual">
                <option value="Disponible"      <%= vehiculo.estado_actual === 'Disponible'      ? 'selected' : '' %>>Disponible</option>
                <option value="En uso"           <%= vehiculo.estado_actual === 'En uso'           ? 'selected' : '' %>>En uso</option>
                <option value="En mantenimiento" <%= vehiculo.estado_actual === 'En mantenimiento' ? 'selected' : '' %>>En mantenimiento</option>
                <option value="Baja"             <%= vehiculo.estado_actual === 'Baja'             ? 'selected' : '' %>>Baja</option>
              </select>
            </div>

            <div class="form-group">
              <label>Kilometraje</label>
              <input name="km_actual" type="number" value="<%= vehiculo.km_actual || 0 %>">
            </div>
          </div>

          <div class="form-group">
            <label>Distrito</label>
            <select name="distrito">
              <option value="Centro" <%= vehiculo.distrito === 'Centro' ? 'selected' : '' %>>Centro</option>
              <option value="Norte"  <%= vehiculo.distrito === 'Norte'  ? 'selected' : '' %>>Norte</option>
              <option value="Sur"    <%= vehiculo.distrito === 'Sur'    ? 'selected' : '' %>>Sur</option>
            </select>
          </div>

          <div class="form-group">
            <label>Observaciones</label>
            <textarea name="observaciones"><%= vehiculo.observaciones || '' %></textarea>
          </div>
        </section>

        <!-- =================== FECHAS =================== -->
        <section class="form-section">
          <h3>Fechas</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Fecha de Alta</label>
              <%# Formateamos a YYYY-MM-DD para que el input type="date" lo reconozca %>
              <input name="fecha_alta" type="date" value="<%= vehiculo.fecha_alta ? new Date(vehiculo.fecha_alta).toISOString().split('T')[0] : '' %>">
            </div>

            <div class="form-group">
              <label>Fecha de Baja</label>
              <input name="fecha_baja" type="date" value="<%= vehiculo.fecha_baja ? new Date(vehiculo.fecha_baja).toISOString().split('T')[0] : '' %>">
            </div>
          </div>
        </section>

        <!-- =================== ACCIONES =================== -->
        <div class="acciones">
          <button type="button" class="boton-secundario" onclick="window.history.back();">Cancelar</button>

          <a href="/Mantenimientos/carga/<%= vehiculo.id_vehiculo %>" class="boton-secundario" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
            <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px;flex-shrink:0;">
              <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
            </svg>
            Registrar Mantenimiento
          </a>

          <button type="submit" class="boton-primario">
            Guardar Cambios
          </button>
        </div>

      </form>

    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="app-footer">
      <p class="app-footer__copy">* Campos obligatorios &nbsp;|&nbsp; &copy; 2025 &mdash; Ficha Tecnica</p>
    </footer>

  </div><!-- /app-wrapper -->

  <script>
    const sidebar      = document.getElementById('sidebar');
    const overlay      = document.getElementById('sidebar-overlay');
    const menuToggle   = document.getElementById('menu-toggle');
    const sidebarClose = document.getElementById('sidebar-close');

    function openSidebar() {
      sidebar.classList.add('sidebar--open');
      overlay.classList.add('sidebar-overlay--visible');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('sidebar--open');
      overlay.classList.remove('sidebar-overlay--visible');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.sidebar__menu-item--expandable > .sidebar__menu-link')
      .forEach(link => {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          const item = this.closest('.sidebar__menu-item--expandable');
          item.classList.toggle('sidebar__menu-item--open');
        });
      });

    document.querySelectorAll('.sidebar__submenu-link--active').forEach(active => {
      const item = active.closest('.sidebar__menu-item--expandable');
      if (item) item.classList.add('sidebar__menu-item--open');
    });

    menuToggle.addEventListener('click', openSidebar);
    sidebarClose.addEventListener('click', closeSidebar);
    overlay.addEventListener('click', closeSidebar);
  </script>

</body>
</html>
