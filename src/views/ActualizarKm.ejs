<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Actualizar Kilometraje - Gestión de Flota</title>
  <link rel="stylesheet" href="/css/ActualizarKm.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
</head>
<body>

  <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

    <!-- ===================== SIDEBAR ===================== -->
  <%- include('./partials/sidebar') %>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper" id="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <%- include('./partials/topbar') %>
    
    <!-- ===================== MAIN ===================== -->
    <main class="main-content" id="main-content">

      <div class="page-header">
        <div class="page-header__left">
          <h2 class="page-title">Actualizar Kilometraje</h2>
          <p class="page-subtitle">Registrá el nuevo kilometraje de un vehículo actualmente asignado.</p>
        </div>
      </div>

      <!-- ===================== FORMULARIO ===================== -->
      <form class="form" action="/ActualizarKm" method="post" id="form-km" novalidate>

        <!-- 1. SELECCIÓN DE VEHÍCULO -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--blue">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
            </div>
            <h3>Vehículo Asignado</h3>
          </div>

          <div class="form-group">
            <label for="id_vehiculo">Seleccionar vehículo <span class="required-star">*</span></label>
            <select name="id_vehiculo" id="id_vehiculo" required>
              <option value="">— Elegir vehículo asignado —</option>
              <% asignaciones.forEach(asig => { %>
                <option
                  value="<%= asig.id_vehiculo %>"
                  data-patente="<%= asig.patente %>"
                  data-detalle="<%= asig.marca %> <%= asig.modelo %> (<%= asig.anio %>)"
                  data-km="<%= asig.km_actual %>"
                  data-chofer="<%= asig.chofer_nombre %> <%= asig.chofer_apellido %>"
                  data-destino="<%= asig.destino_area || '—' %>"
                  data-salida="<%= asig.fecha_salida ? new Date(asig.fecha_salida).toLocaleDateString('es-AR') : '—' %>"
                >
                  <%= asig.id_vehiculo %> — <%= asig.patente %> · <%= asig.marca %> <%= asig.modelo %>
                </option>
              <% }) %>
            </select>
            <span class="field-error" id="err-vehiculo"></span>
          </div>

          <div class="vehicle-card" id="vehicle-card" aria-live="polite">
            <div class="vehicle-card__badge">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
            </div>
            <div class="vehicle-card__info">
              <div class="vehicle-card__patente" id="vc-patente">—</div>
              <div class="vehicle-card__detail"  id="vc-detalle">—</div>
            </div>
            <div class="vehicle-card__km" id="vc-km">— km</div>
          </div>

          <div class="chofer-card" id="chofer-card" aria-live="polite">
            <div class="chofer-card__icon">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            </div>
            <div class="chofer-card__data">
              <span class="chofer-card__label">Chofer asignado</span>
              <span class="chofer-card__nombre" id="cc-nombre">—</span>
            </div>
            <div class="chofer-card__data">
              <span class="chofer-card__label">Destino / Área</span>
              <span class="chofer-card__valor" id="cc-destino">—</span>
            </div>
            <div class="chofer-card__data">
              <span class="chofer-card__label">Fecha de salida</span>
              <span class="chofer-card__valor" id="cc-salida">—</span>
            </div>
          </div>
        </section>

        <!-- 2. ACTUALIZACIÓN DEL KM -->
        <section class="form-section">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--amber">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
            </div>
            <h3>Nuevo Kilometraje</h3>
          </div>

          <div class="km-update-layout">
            <div class="km-display-block">
              <span class="km-display-block__label">Kilometraje actual registrado</span>
              <div class="km-display-block__value" id="km-actual-display">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                <span id="km-actual-texto">Seleccioná un vehículo</span>
              </div>
            </div>
            <div class="km-arrow">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </div>
            <div class="form-group km-nuevo-group">
              <label for="km_nuevo">Nuevo kilometraje <span class="required-star">*</span></label>
              <div class="km-input-wrapper">
                <input type="number" name="km_nuevo" id="km_nuevo" min="0" placeholder="Ej: 102500" required autocomplete="off">
                <span class="km-input-unit">km</span>
              </div>
              <span class="field-error" id="err-km"></span>
              <span class="form-group__hint" id="km-diff-hint"></span>
            </div>
          </div>
        </section>

        <!-- 3. FECHA Y OBSERVACIONES -->
        <section class="form-section form-col-full">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--slate">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            </div>
            <h3>Fecha y Observaciones</h3>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="fecha_actualizacion">Fecha de actualización <span class="required-star">*</span></label>
              <input type="date" name="fecha_actualizacion" id="fecha_actualizacion" required>
              <span class="field-error" id="err-fecha"></span>
            </div>
            <div class="form-group">
              <label for="observaciones">Observaciones</label>
              <input type="text" name="observaciones" id="observaciones" placeholder="Ej: Lectura tomada al retorno de ruta norte…">
            </div>
          </div>
        </section>

        <!-- ACCIONES -->
        <div class="acciones form-col-full">
          <button type="button" class="boton-secundario" onclick="history.back()">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
            Volver
          </button>
          <button type="submit" class="boton-primario" id="btn-guardar">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Guardar Kilometraje
          </button>
        </div>

      </form>

      <!-- ===================== HISTORIAL ===================== -->
      <div class="historial-wrapper">

        <!-- Selector de vehículo para el historial -->
        <section class="form-section historial-selector-card">
          <div class="form-section__header">
            <div class="form-section__icon form-section__icon--blue">
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
            </div>
            <div>
              <h3>Historial de Kilometraje</h3>
              <p>Seleccioná un vehículo para ver su evolución</p>
            </div>
          </div>

          <div class="form-group">
            <label for="id_vehiculo_historial">Vehículo</label>
            <% if (vehiculosConHistorial && vehiculosConHistorial.length > 0) { %>
              <select id="id_vehiculo_historial">
                <option value="">— Elegir vehículo —</option>
                <% vehiculosConHistorial.forEach(v => { %>
                  <option value="<%= v.id_vehiculo %>">
                    <%= v.patente %> · <%= v.marca %> <%= v.modelo %> — <%= v.km_actual.toLocaleString('es-AR') %> km
                  </option>
                <% }) %>
              </select>
            <% } else { %>
              <div class="historial-empty-inline">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 4a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H5zm-1 9v-1h5v2H5a1 1 0 01-1-1zm7 1h4a1 1 0 001-1v-1h-5v2zm0-4h5V8h-5v2zM9 8H4v2h5V8z" clip-rule="evenodd"/></svg>
                <span>Todavía no hay registros de kilometraje cargados.</span>
              </div>
            <% } %>
          </div>
        </section>

        <!-- Gráfico + Tabla — se muestran al seleccionar -->
        <section class="historial-section" id="historial-section" style="display:none">

          <div class="historial-chart-card">
            <div class="historial-chart-card__header">
              <div class="form-section__icon form-section__icon--blue">
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
              </div>
              <div>
                <h3>Evolución de Kilometraje</h3>
                <p id="chart-subtitle">—</p>
              </div>
            </div>
            <div class="historial-chart-card__canvas">
              <canvas id="kmChart"></canvas>
            </div>
          </div>

          <div class="historial-table-card">
            <div class="historial-table-card__header">
              <div class="form-section__icon form-section__icon--slate">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 4a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H5zm-1 9v-1h5v2H5a1 1 0 01-1-1zm7 1h4a1 1 0 001-1v-1h-5v2zm0-4h5V8h-5v2zM9 8H4v2h5V8z" clip-rule="evenodd"/></svg>
              </div>
              <div>
                <h3>Registros</h3>
                <p id="tabla-subtitle">—</p>
              </div>
            </div>
            <div class="historial-table-wrapper">
              <table class="historial-table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>KM Anterior</th>
                    <th>KM Nuevo</th>
                    <th>Diferencia</th>
                    <th>Observaciones</th>
                  </tr>
                </thead>
                <tbody id="historial-tbody"></tbody>
              </table>
            </div>
            <div class="historial-empty" id="historial-empty" style="display:none">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 4a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H5zm-1 9v-1h5v2H5a1 1 0 01-1-1zm7 1h4a1 1 0 001-1v-1h-5v2zm0-4h5V8h-5v2zM9 8H4v2h5V8z" clip-rule="evenodd"/></svg>
              <p>Este vehículo no tiene registros aún.</p>
            </div>
          </div>

        </section>

      </div>

    </main>

    <footer class="app-footer">
      <p class="app-footer__copy">* Campos obligatorios &nbsp;|&nbsp; &copy; 2025 &mdash; Ficha Tecnica · Municipalidad</p>
    </footer>

  </div>
  <script src="/js/sidebar.js"></script>
  <script>
    /* ── Sidebar ─────────────────────────────────────── */
    const sidebar      = document.getElementById('sidebar');
    const overlay      = document.getElementById('sidebar-overlay');
    const menuToggle   = document.getElementById('menu-toggle');
    const sidebarClose = document.getElementById('sidebar-close');

    function openSidebar() {
      sidebar.classList.add('sidebar--open');
      overlay.classList.add('sidebar-overlay--visible');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('sidebar--open');
      overlay.classList.remove('sidebar-overlay--visible');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    menuToggle  .addEventListener('click', openSidebar);
    sidebarClose.addEventListener('click', closeSidebar);
    overlay     .addEventListener('click', closeSidebar);

    document.querySelectorAll('.sidebar__menu-item--expandable > .sidebar__menu-link')
      .forEach(link => {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          this.closest('.sidebar__menu-item--expandable').classList.toggle('sidebar__menu-item--open');
        });
      });
    document.querySelectorAll('.sidebar__submenu-link--active').forEach(active => {
      const item = active.closest('.sidebar__menu-item--expandable');
      if (item) item.classList.add('sidebar__menu-item--open');
    });

    /* ── Formulario: selección de vehículo asignado ─── */
    const vehicleSelect = document.getElementById('id_vehiculo');
    const vehicleCard   = document.getElementById('vehicle-card');
    const choferCard    = document.getElementById('chofer-card');
    const vcPatente     = document.getElementById('vc-patente');
    const vcDetalle     = document.getElementById('vc-detalle');
    const vcKm          = document.getElementById('vc-km');
    const kmActualTexto = document.getElementById('km-actual-texto');
    const ccNombre      = document.getElementById('cc-nombre');
    const ccDestino     = document.getElementById('cc-destino');
    const ccSalida      = document.getElementById('cc-salida');
    const kmNuevoInput  = document.getElementById('km_nuevo');
    const kmDiffHint    = document.getElementById('km-diff-hint');
    let kmActualGlobal  = null;

    vehicleSelect.addEventListener('change', function () {
      const opt = this.options[this.selectedIndex];
      if (!this.value) {
        vehicleCard.classList.remove('visible');
        choferCard.classList.remove('visible');
        kmActualTexto.textContent = 'Seleccioná un vehículo';
        kmActualGlobal = null;
        kmDiffHint.textContent = '';
        return;
      }
      vcPatente.textContent = opt.dataset.patente || '—';
      vcDetalle.textContent = opt.dataset.detalle || '—';
      const kmNum = parseInt(opt.dataset.km) || 0;
      vcKm.textContent = kmNum.toLocaleString('es-AR') + ' km';
      vehicleCard.classList.add('visible');
      kmActualGlobal = kmNum;
      kmActualTexto.textContent = kmNum.toLocaleString('es-AR') + ' km';
      ccNombre.textContent  = opt.dataset.chofer  || '—';
      ccDestino.textContent = opt.dataset.destino || '—';
      ccSalida.textContent  = opt.dataset.salida  || '—';
      choferCard.classList.add('visible');
      if (!kmNuevoInput.value) kmNuevoInput.value = kmNum;
      actualizarDiff();
    });

    function actualizarDiff() {
      if (kmActualGlobal === null) { kmDiffHint.textContent = ''; return; }
      const nuevo = parseInt(kmNuevoInput.value);
      if (isNaN(nuevo)) { kmDiffHint.textContent = ''; return; }
      const diff = nuevo - kmActualGlobal;
      if (diff > 0) {
        kmDiffHint.textContent = `+${diff.toLocaleString('es-AR')} km respecto al registro actual`;
        kmDiffHint.className = 'form-group__hint hint--positivo';
      } else if (diff === 0) {
        kmDiffHint.textContent = 'Sin cambios respecto al registro actual';
        kmDiffHint.className = 'form-group__hint hint--neutro';
      } else {
        kmDiffHint.textContent = `⚠ El nuevo valor es menor al actual (${Math.abs(diff).toLocaleString('es-AR')} km menos)`;
        kmDiffHint.className = 'form-group__hint hint--advertencia';
      }
    }
    kmNuevoInput.addEventListener('input', actualizarDiff);

    /* ── Fecha: por defecto hoy, máximo hoy ─────────── */
    const fechaInput = document.getElementById('fecha_actualizacion');
    const hoy = new Date().toISOString().split('T')[0];
    fechaInput.max   = hoy;
    if (!fechaInput.value) fechaInput.value = hoy;

    /* ── Validación ──────────────────────────────────── */
    function setError(inputId, errId, msg) {
      const el = document.getElementById(inputId);
      const er = document.getElementById(errId);
      if (msg) {
        el?.classList.add('input-error');
        if (er) er.textContent = msg;
      } else {
        el?.classList.remove('input-error');
        if (er) er.textContent = '';
      }
    }

    document.getElementById('form-km').addEventListener('submit', function (e) {
      e.preventDefault();
      document.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
      document.querySelectorAll('.field-error').forEach(el => el.textContent = '');

      let valido = true;

      if (!vehicleSelect.value) {
        setError('id_vehiculo', 'err-vehiculo', 'Seleccioná un vehículo asignado.');
        valido = false;
      }
      const kmNuevo = parseInt(kmNuevoInput.value);
      if (isNaN(kmNuevo) || kmNuevo < 0) {
        setError('km_nuevo', 'err-km', 'Ingresá un kilometraje válido (mayor o igual a 0).');
        valido = false;
      }
      if (!fechaInput.value) {
        setError('fecha_actualizacion', 'err-fecha', 'La fecha de actualización es obligatoria.');
        valido = false;
      } else if (fechaInput.value > hoy) {
        setError('fecha_actualizacion', 'err-fecha', 'No podés ingresar una fecha futura.');
        valido = false;
      }

      if (valido) this.submit();
    });

    ['id_vehiculo', 'km_nuevo', 'fecha_actualizacion'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', function () {
        this.classList.remove('input-error');
        const map = { id_vehiculo: 'err-vehiculo', km_nuevo: 'err-km', fecha_actualizacion: 'err-fecha' };
        const er = document.getElementById(map[id]);
        if (er) er.textContent = '';
      });
    });

    if (vehicleSelect.value) vehicleSelect.dispatchEvent(new Event('change'));

    /* ── Historial: selector independiente ───────────── */
    const historialTodos = <%- JSON.stringify(historial.map(h => ({
      id_vehiculo:   h.id_vehiculo,
      fecha:         h.fecha,
      km_anterior:   h.km_anterior,
      km_nuevo:      h.km_nuevo,
      observaciones: h.observaciones || null,
      patente:       h.vehiculo ? h.vehiculo.patente : '—',
      modelo:        h.vehiculo ? (h.vehiculo.marca + ' ' + h.vehiculo.modelo) : '—'
    }))) %>;

    let kmChartInstance = null;

    const historialSelect = document.getElementById('id_vehiculo_historial');
    if (historialSelect) {
      historialSelect.addEventListener('change', function () {
        renderHistorial(this.value);
      });
    }

    function renderHistorial(id_vehiculo) {
      const seccion  = document.getElementById('historial-section');
      const tbody    = document.getElementById('historial-tbody');
      const empty    = document.getElementById('historial-empty');
      const subtitle = document.getElementById('chart-subtitle');
      const tabSub   = document.getElementById('tabla-subtitle');

      if (!id_vehiculo) { seccion.style.display = 'none'; return; }

      const datos = historialTodos
        .filter(h => h.id_vehiculo == id_vehiculo)
        .sort((a, b) => new Date(a.fecha) - new Date(b.fecha));

      seccion.style.display = 'grid';

      const patente = datos.length ? datos[0].patente : '—';
      const modelo  = datos.length ? datos[0].modelo  : '—';
      subtitle.textContent = `${patente} · ${modelo}`;
      tabSub.textContent   = `${datos.length} registro${datos.length !== 1 ? 's' : ''}`;

      // Tabla — más reciente primero
      tbody.innerHTML = '';
      if (datos.length === 0) {
        empty.style.display = 'flex';
      } else {
        empty.style.display = 'none';
        datos.slice().reverse().forEach(reg => {
          const diff      = reg.km_nuevo - reg.km_anterior;
          const diffClass = diff > 0 ? 'diff--pos' : diff < 0 ? 'diff--neg' : 'diff--zero';
          const diffText  = (diff > 0 ? '+' : '') + diff.toLocaleString('es-AR') + ' km';
          const fecha     = new Date(reg.fecha).toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' });
          tbody.innerHTML += `
            <tr>
              <td data-label="Fecha"><span class="historial-fecha">${fecha}</span></td>
              <td data-label="KM Anterior"><span class="historial-km historial-km--ant">${reg.km_anterior.toLocaleString('es-AR')} km</span></td>
              <td data-label="KM Nuevo"><span class="historial-km historial-km--new">${reg.km_nuevo.toLocaleString('es-AR')} km</span></td>
              <td data-label="Diferencia"><span class="historial-diff ${diffClass}">${diffText}</span></td>
              <td data-label="Observaciones"><span class="historial-obs">${reg.observaciones || '—'}</span></td>
            </tr>`;
        });
      }

      // Gráfico
      if (kmChartInstance) { kmChartInstance.destroy(); kmChartInstance = null; }
      if (datos.length === 0) return;

      kmChartInstance = new Chart(document.getElementById('kmChart'), {
        type: 'line',
        data: {
          labels: datos.map(h => new Date(h.fecha).toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'2-digit' })),
          datasets: [{
            label: 'Kilometraje',
            data: datos.map(h => h.km_nuevo),
            borderColor: '#1d4ed8',
            backgroundColor: 'rgba(29, 78, 216, 0.08)',
            borderWidth: 2,
            pointBackgroundColor: '#1d4ed8',
            pointRadius: 4,
            pointHoverRadius: 6,
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: items => `Fecha: ${items[0].label}`,
                label: item  => ` ${item.raw.toLocaleString('es-AR')} km`
              }
            }
          },
          scales: {
            x: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#94a3b8' } },
            y: {
              grid: { color: '#f1f5f9' },
              ticks: { font: { size: 11 }, color: '#94a3b8', callback: v => v.toLocaleString('es-AR') + ' km' }
            }
          }
        }
      });
    }
  </script>

</body>
</html>
