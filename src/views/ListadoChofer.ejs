<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mantenimientos - Gestión de Flota</title>
    <link rel="stylesheet" href="/css/ListadoChofer.css">
    <style>
        td.venc-vencido span,
        td.venc-proximo span,
        td.venc-vigente span  { display: none; }

        td[data-vencimiento] .badge-venc {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        td.venc-vencido .badge-venc { background-color: #fee2e2; color: #991b1b; }
        td.venc-proximo .badge-venc { background-color: #fef9c3; color: #854d0e; }
        td.venc-vigente .badge-venc { background-color: #dcfce7; color: #166534; }

        tr.fila-oculta { display: none; }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Overlay para cerrar sidebar en mobile/tablet -->
    <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

    <!-- ===================== SIDEBAR ===================== -->
    <aside class="sidebar" id="sidebar" aria-label="Menú de navegación">

        <div class="sidebar__brand">
            <div class="sidebar__logo">
                 <img class="imglogosidebar" src="/images/header/images-removebg-preview (1).png" alt="">
            </div>
            <div class="sidebar__brand-text">
                <span class="sidebar__brand-name">Ficha Tecnica</span>
                <span class="sidebar__brand-sub">Municipalidad</span>
            </div>
            <button class="sidebar__close-btn" id="sidebar-close" aria-label="Cerrar menú">
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>
        </div>

        <nav class="sidebar__nav" aria-label="Navegación principal">
            <span class="sidebar__nav-label">Menú Principal</span>

            <ul class="sidebar__menu">

                <li class="sidebar__menu-item">
                  <a href="#" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
                    Inicio
                  </a>
                </li>
              
                <li class="sidebar__menu-item sidebar__menu-item--expandable">
                  <a href="#" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
                    Vehículos
                    <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                  <ul class="sidebar__submenu">
                    <li><a href="/Vehicles" class="sidebar__submenu-link">Listado de vehículos</a></li>
                    <li><a href="/CargaVehiculo" class="sidebar__submenu-link">Agregar vehículo</a></li>
                  </ul>
                </li>
              
                <li class="sidebar__menu-item sidebar__menu-item--expandable">
                  <a href="#" class="sidebar__menu-link sidebar__menu-link--active">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                    Choferes
                    <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                  <ul class="sidebar__submenu">
                    <li><a href="/Choferes" class="sidebar__submenu-link sidebar__submenu-link--active">Listado de choferes</a></li>
                    <li><a href="/Choferes/carga" class="sidebar__submenu-link">Agregar chofer</a></li>
                  </ul>
                </li>
              
                <li class="sidebar__menu-item sidebar__menu-item--expandable">
                  <a href="#" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                    Mantenimientos
                    <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                  <ul class="sidebar__submenu">
                    <li><a href="/Mantenimientos" class="sidebar__submenu-link">Listado</a></li>
                    <li><a href="/Mantenimientos/carga" class="sidebar__submenu-link">Agregar mantenimiento</a></li>
                  </ul>
                </li>
              
                <li class="sidebar__menu-item sidebar__menu-item--expandable">
                  <a href="#" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6.672 1.911a1 1 0 10-1.932.518l.259.966a1 1 0 001.932-.518l-.26-.966zM2.429 4.74a1 1 0 10-.517 1.932l.966.259a1 1 0 00.517-1.932l-.966-.26zm8.814-.569a1 1 0 00-1.415-1.414l-.707.707a1 1 0 101.415 1.415l.707-.708zm-7.071 7.072l.707-.707A1 1 0 003.465 9.12l-.708.707a1 1 0 001.415 1.415zm3.2-5.171a1 1 0 00-1.3 1.3l4 10a1 1 0 001.823.075l1.38-2.759 3.018 3.02a1 1 0 001.414-1.415l-3.019-3.02 2.76-1.379a1 1 0 00-.076-1.822l-10-4z" clip-rule="evenodd"/></svg>
                    Herramientas
                    <svg class="sidebar__menu-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                  <ul class="sidebar__submenu">
                    <li><a href="/Tools" class="sidebar__submenu-link">Inventario</a></li>
                    <li><a href="/Tools/carga" class="sidebar__submenu-link">Carga herramienta</a></li>
                    <li><a href="/Tools/prestamos" class="sidebar__submenu-link">Préstamos</a></li>
                    <li><a href="/Tools/ajustes" class="sidebar__submenu-link">Ajustes</a></li>
                  </ul>
                </li>
              
                <li class="sidebar__menu-item">
                  <a href="/Alertas" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
                    Alertas
                    <span class="sidebar__badge">5</span>
                  </a>
                </li>
              
                <li class="sidebar__menu-item">
                  <a href="#" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                    Usuarios
                  </a>
                </li>
              
                <li class="sidebar__menu-item">
                  <a href="#" class="sidebar__menu-link">
                    <svg class="sidebar__menu-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"/></svg>
                    Auditoría
                  </a>
                </li>
              
              </ul>
        </nav>
    </aside>

    <!-- ===================== APP WRAPPER ===================== -->
    <div class="app-wrapper">

        <!-- ===================== HEADER ===================== -->
        <header class="topbar">
            <button class="topbar__menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <div class="topbar__mobile-brand" aria-hidden="true">
                <img class="imglogosidebarcel" src="/images/header/images-removebg-preview (1).png" alt="">
                <span>Gestión de Flota</span>
            </div>

            <div class="topbar__actions">
                <button class="topbar__notification-btn" aria-label="Notificaciones (3 sin leer)">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
                    <span class="topbar__notification-dot" aria-label="3 notificaciones">3</span>
                </button>
                <div class="topbar__user" role="button" tabindex="0">
                    <svg class="topbar__user-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
                    <span class="topbar__user-name">Administrador</span>
                    <svg class="topbar__user-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                </div>
            </div>
        </header>

        <!-- ===================== MAIN ===================== -->
        <main class="Main-content">

            <h2>Choferes</h2>
            <p class="descripcion">Listado de Choferes de Recursos Hídricos.</p>

            <div class="acciones">
                <button class="exportar">Exportar</button>
                <a href="/Choferes/Carga" class="nuevo-chofer">Nuevo Chofer</a>
            </div>

            <section class="box-main">

                <form method="GET" action="/Choferes">

                    <section class="box-filtros">

                        <div class="filtro">
                            <label>Buscar</label>
                            <input name="buscar" class="input" type="search" placeholder="Dni, apellido...">
                        </div>

                        <div class="filtro">
                            <label>Fecha desde</label>
                            <input name="fechaDesde" class="input" type="date">
                        </div>

                        <div class="filtro">
                            <label>Fecha hasta</label>
                            <input name="fechaHasta" class="input" type="date">
                        </div>

                        <div class="filtro">
                            <label>Categoría</label>
                                    <select class="input" name="categoriaLicencia">
                                        <option value="">Seleccione categoría</option>
                                        <option value="A">A - Motocicletas</option>
                                        <option value="B1">B1 - Autos y camionetas</option>
                                        <option value="B2">B2 - Vehículos utilitarios</option>
                                        <option value="C">C - Camiones sin acoplado</option>
                                        <option value="D">D - Transporte de pasajeros</option>
                                        <option value="E">E - Camiones con acoplado</option>
                                        <option value="G">G - Maquinaria especial</option>
                                    </select> 
                        </div>

                        <div class="filtro">
                            <label>Tipo de Vehículo</label>
                                    <select name="tipoVehiculo" class="input">
                                        <option value="">Todos</option>
                                        <option>Camión</option>
                                        <option>Camioneta</option>
                                        <option>Auto</option>
                                        <option>Maquinaria</option>
                                    </select>
                        </div>

                        <div class="filtro">
                            <label>Estado</label>
                            <select name="estado" class="input">
                                <option value="">Todos</option>
                                <option>Activo</option>
                                <option>Inactivo</option>
                            </select>
                        </div>

                        <div class="filtro filtro-boton">
                            <a href="/Choferes" class="boton-limpiar">Limpiar</a>
                        </div>

                        <div class="filtro filtro-boton">
                            <button type="submit" class="btn-filtrar">Filtrar</button>
                        </div>

                    </section>
                </form>

                <section class="box-lista">

                    <div class="tabla-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Chofer</th>
                                    <th>DNI</th>
                                    <th>Licencia</th>
                                    <th>Categoría</th>
                                    <th>Vencimiento</th>
                                    <th>Vehículo</th>
                                    <th>Teléfono</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>

                                <% choferes.forEach(chofer => { %>

                                    <tr>

                                        <td data-label="Chofer">
                                            <%= chofer.nombre %> <%= chofer.apellido %>
                                        </td>

                                        <td data-label="DNI">
                                            <%= chofer.dni %>
                                        </td>

                                        <td data-label="Licencia">
                                            <%= chofer.licencias.length > 0 ? chofer.licencias[0].numero : '-' %>
                                        </td>

                                        <td data-label="Categoría">
                                            <%= chofer.licencias.length > 0 ? chofer.licencias[0].categoria : '-' %>
                                        </td>

                                        <td data-label="Vencimiento" data-vencimiento="<%= chofer.licencias.length > 0 && chofer.licencias[0].fecha_vencimiento ? new Date(chofer.licencias[0].fecha_vencimiento).toISOString().split('T')[0] : '' %>">
                                            <span class="badge-venc">
                                                <%= chofer.licencias.length > 0 && chofer.licencias[0].fecha_vencimiento
                                                    ? new Date(chofer.licencias[0].fecha_vencimiento).toLocaleDateString('es-AR')
                                                    : '-' %>
                                            </span>
                                        </td>

                                        <td data-label="Vehículo">
                                            <%= chofer.asignaciones.length > 0 
                                            ? chofer.asignaciones[0].vehiculo.patente 
                                            : '-' %>
                                        </td>

                                        <td data-label="Teléfono">
                                            <%= chofer.telefono %>
                                        </td>

                                        <td data-label="Estado">
                                            <%= chofer.estado %>
                                        </td>

                                        <td data-label="Acciones">

                                            <a href="/Choferes/<%= chofer.id_chofer %>/editar" class="btn-accion btn-editar">
                                            Editar
                                            </a>

                                            <% if (chofer.estado === 'Activo') { %>
                                                <form method="POST" action="/Choferes/<%= chofer.id_chofer %>/desactivar"
                                                    style="display:inline"
                                                    onsubmit="return confirm('¿Desactivar a <%= chofer.nombre %> <%= chofer.apellido %>?')">
                                                    <button type="submit" class="btn-accion btn-desactivar">
                                                        Desactivar
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="badge-inactivo">Inactivo</span>
                                            <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>
                        </table>
                    </div>

                </section>

                <section class="box-cambiarLista">

                    <p class="info">
                        Mostrando página <%= paginaActual %> de <%= totalPaginas %>
                        &nbsp;|&nbsp; <%= totalRegistros %> resultado<%= totalRegistros !== 1 ? 's' : '' %>
                    </p>

                    <div class="paginacion">

                        <%
                            // Base de la URL para los links de paginación
                            const base = '/Choferes?' + (queryString ? queryString + '&' : '');
                        %>

                        
                        <% if (paginaActual > 1) { %>
                            <a href="<%= base %>pagina=<%= paginaActual - 1 %>" class="cambiar">Anterior</a>
                        <% } else { %>
                            <button class="cambiar" disabled>Anterior</button>
                        <% } %>

                        
                        <% for (let i = 1; i <= totalPaginas; i++) { %>
                            <% if (i === paginaActual) { %>
                                <button class="pagina pagina--activa"><%= i %></button>
                            <% } else { %>
                                <a href="<%= base %>pagina=<%= i %>" class="pagina"><%= i %></a>
                            <% } %>
                        <% } %>

                        
                        <% if (paginaActual < totalPaginas) { %>
                            <a href="<%= base %>pagina=<%= paginaActual + 1 %>" class="cambiar">Siguiente</a>
                        <% } else { %>
                            <button class="cambiar" disabled>Siguiente</button>
                        <% } %>

                    </div>

                </section>

            </section>

        </main>

        <!-- ===================== FOOTER ===================== -->
        <footer class="app-footer">
            <p class="app-footer__copy">&copy; 2025 &mdash; Ficha Tecnica</p>
        </footer>

    </div><!-- /app-wrapper -->

    <script>
        /* ── SIDEBAR TOGGLE ─────────────────────────────────────── */
        const sidebar      = document.getElementById('sidebar');
        const overlay      = document.getElementById('sidebar-overlay');
        const menuToggle   = document.getElementById('menu-toggle');
        const sidebarClose = document.getElementById('sidebar-close');

        document.querySelectorAll('.sidebar__menu-item--expandable > .sidebar__menu-link')
            .forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const item = this.closest('.sidebar__menu-item--expandable');
                    item.classList.toggle('sidebar__menu-item--open');
                });
            });

        document.querySelectorAll('.sidebar__submenu-link--active').forEach(active => {
            const item = active.closest('.sidebar__menu-item--expandable');
            if (item) item.classList.add('sidebar__menu-item--open');
        });

        function openSidebar() {
            sidebar.classList.add('sidebar--open');
            overlay.classList.add('sidebar-overlay--visible');
            menuToggle.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            sidebar.classList.remove('sidebar--open');
            overlay.classList.remove('sidebar-overlay--visible');
            menuToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        }

        menuToggle.addEventListener('click', openSidebar);
        sidebarClose.addEventListener('click', closeSidebar);
        overlay.addEventListener('click', closeSidebar);

        /* ── COLORES POR VENCIMIENTO ────────────────────────────── */
        const DIAS_ROJO     = 30;
        const DIAS_AMARILLO = 90;

        document.querySelectorAll('tbody tr').forEach(fila => {
            const celda = fila.querySelector('td[data-vencimiento]');
            if (!celda) return;

            const fechaStr = celda.getAttribute('data-vencimiento');
            if (!fechaStr) return;

            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            const vencimiento = new Date(fechaStr);
            const diffDias = Math.ceil((vencimiento - hoy) / (1000 * 60 * 60 * 24));

            // Corregido: clase sobre la celda, no sobre la fila
            if (diffDias <= DIAS_ROJO) {
                celda.classList.add('venc-vencido');
            } else if (diffDias <= DIAS_AMARILLO) {
                celda.classList.add('venc-proximo');
            } else {
                celda.classList.add('venc-vigente');
            }
        });

        /* ── BÚSQUEDA EN TIEMPO REAL ────────────────────────────── */
        const inputBuscar = document.querySelector('input[name="buscar"]');

        if (inputBuscar) {
            inputBuscar.addEventListener('input', function () {
                const termino = this.value.toLowerCase().trim();
                const filas   = document.querySelectorAll('tbody tr');

                filas.forEach(fila => {
                    // Busca en todas las celdas de la fila excepto Acciones
                    const celdas  = fila.querySelectorAll('td:not([data-label="Acciones"])');
                    const textoFila = Array.from(celdas)
                        .map(td => td.textContent.toLowerCase())
                        .join(' ');

                    if (textoFila.includes(termino)) {
                        fila.classList.remove('fila-oculta');
                    } else {
                        fila.classList.add('fila-oculta');
                    }
                });
            });
        }
    </script>

</body>
</html>
