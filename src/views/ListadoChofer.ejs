<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mantenimientos - Gestión de Flota</title>
    <link rel="stylesheet" href="/css/ListadoChofer.css">
    <style>
        td.venc-vencido span,
        td.venc-proximo span,
        td.venc-vigente span  { display: none; }

        td[data-vencimiento] .badge-venc {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        td.venc-vencido .badge-venc { background-color: #fee2e2; color: #991b1b; }
        td.venc-proximo .badge-venc { background-color: #fef9c3; color: #854d0e; }
        td.venc-vigente .badge-venc { background-color: #dcfce7; color: #166534; }

        tr.fila-oculta { display: none; }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

    <!-- ===================== SIDEBAR ===================== -->
  <%- include('./partials/sidebar') %>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper" id="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <%- include('./partials/topbar') %>

        <!-- ===================== MAIN ===================== -->
        <main class="Main-content">

            <h2>Choferes</h2>
            <p class="descripcion">Listado de Choferes de Recursos Hídricos.</p>

            <div class="acciones">
                <button class="exportar">Exportar</button>
                <a href="/Choferes/Carga" class="nuevo-chofer">Nuevo Chofer</a>
            </div>

            <section class="box-main">

                <form method="GET" action="/Choferes">

                    <section class="box-filtros">

                        <div class="filtro">
                            <label>Buscar</label>
                            <input name="buscar" class="input" type="search" placeholder="Dni, apellido...">
                        </div>

                        <div class="filtro">
                            <label>Fecha desde</label>
                            <input name="fechaDesde" class="input" type="date">
                        </div>

                        <div class="filtro">
                            <label>Fecha hasta</label>
                            <input name="fechaHasta" class="input" type="date">
                        </div>

                        <div class="filtro">
                            <label>Categoría</label>
                                    <select class="input" name="categoriaLicencia">
                                        <option value="">Seleccione categoría</option>
                                        <option value="A">A - Motocicletas</option>
                                        <option value="B1">B1 - Autos y camionetas</option>
                                        <option value="B2">B2 - Vehículos utilitarios</option>
                                        <option value="C">C - Camiones sin acoplado</option>
                                        <option value="D">D - Transporte de pasajeros</option>
                                        <option value="E">E - Camiones con acoplado</option>
                                        <option value="G">G - Maquinaria especial</option>
                                    </select> 
                        </div>

                        <div class="filtro">
                            <label>Tipo de Vehículo</label>
                                    <select name="tipoVehiculo" class="input">
                                        <option value="">Todos</option>
                                        <option>Camión</option>
                                        <option>Camioneta</option>
                                        <option>Auto</option>
                                        <option>Maquinaria</option>
                                    </select>
                        </div>

                        <div class="filtro">
                            <label>Estado</label>
                            <select name="estado" class="input">
                                <option value="">Todos</option>
                                <option>Activo</option>
                                <option>Inactivo</option>
                            </select>
                        </div>

                        <div class="filtro filtro-boton">
                            <a href="/Choferes" class="boton-limpiar">Limpiar</a>
                        </div>

                        <div class="filtro filtro-boton">
                            <button type="submit" class="btn-filtrar">Filtrar</button>
                        </div>

                    </section>
                </form>

                <section class="box-lista">

                    <div class="tabla-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Chofer</th>
                                    <th>DNI</th>
                                    <th>Licencia</th>
                                    <th>Categoría</th>
                                    <th>Vencimiento</th>
                                    <th>Vehículo</th>
                                    <th>Teléfono</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>

                                <% choferes.forEach(chofer => { %>

                                    <tr>

                                        <td data-label="Chofer">
                                            <%= chofer.nombre %> <%= chofer.apellido %>
                                        </td>

                                        <td data-label="DNI">
                                            <%= chofer.dni %>
                                        </td>

                                        <td data-label="Licencia">
                                            <%= chofer.licencias.length > 0 ? chofer.licencias[0].numero : '-' %>
                                        </td>

                                        <td data-label="Categoría">
                                            <%= chofer.licencias.length > 0 ? chofer.licencias[0].categoria : '-' %>
                                        </td>

                                        <td data-label="Vencimiento" data-vencimiento="<%= chofer.licencias.length > 0 && chofer.licencias[0].fecha_vencimiento ? new Date(chofer.licencias[0].fecha_vencimiento).toISOString().split('T')[0] : '' %>">
                                            <span class="badge-venc">
                                                <%= chofer.licencias.length > 0 && chofer.licencias[0].fecha_vencimiento
                                                    ? new Date(chofer.licencias[0].fecha_vencimiento).toLocaleDateString('es-AR')
                                                    : '-' %>
                                            </span>
                                        </td>

                                        <td data-label="Vehículo">
                                            <%= chofer.asignaciones.length > 0 
                                            ? chofer.asignaciones[0].vehiculo.patente 
                                            : '-' %>
                                        </td>

                                        <td data-label="Teléfono">
                                            <%= chofer.telefono %>
                                        </td>

                                        <td data-label="Estado">
                                            <%= chofer.estado %>
                                        </td>

                                        <td data-label="Acciones">

                                            <a href="/Choferes/<%= chofer.id_chofer %>/editar" class="btn-accion btn-editar">
                                            Editar
                                            </a>

                                            <% if (chofer.estado === 'Activo') { %>
                                                <form method="POST" action="/Choferes/<%= chofer.id_chofer %>/desactivar"
                                                    style="display:inline"
                                                    onsubmit="return confirm('¿Desactivar a <%= chofer.nombre %> <%= chofer.apellido %>?')">
                                                    <button type="submit" class="btn-accion btn-desactivar">
                                                        Desactivar
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="badge-inactivo">Inactivo</span>
                                            <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>
                        </table>
                    </div>

                </section>

                <section class="box-cambiarLista">

                    <p class="info">
                        Mostrando página <%= paginaActual %> de <%= totalPaginas %>
                        &nbsp;|&nbsp; <%= totalRegistros %> resultado<%= totalRegistros !== 1 ? 's' : '' %>
                    </p>

                    <div class="paginacion">

                        <%
                            // Base de la URL para los links de paginación
                            const base = '/Choferes?' + (queryString ? queryString + '&' : '');
                        %>

                        
                        <% if (paginaActual > 1) { %>
                            <a href="<%= base %>pagina=<%= paginaActual - 1 %>" class="cambiar">Anterior</a>
                        <% } else { %>
                            <button class="cambiar" disabled>Anterior</button>
                        <% } %>

                        
                        <% for (let i = 1; i <= totalPaginas; i++) { %>
                            <% if (i === paginaActual) { %>
                                <button class="pagina pagina--activa"><%= i %></button>
                            <% } else { %>
                                <a href="<%= base %>pagina=<%= i %>" class="pagina"><%= i %></a>
                            <% } %>
                        <% } %>

                        
                        <% if (paginaActual < totalPaginas) { %>
                            <a href="<%= base %>pagina=<%= paginaActual + 1 %>" class="cambiar">Siguiente</a>
                        <% } else { %>
                            <button class="cambiar" disabled>Siguiente</button>
                        <% } %>

                    </div>

                </section>

            </section>

        </main>

        <!-- ===================== FOOTER ===================== -->
        <footer class="app-footer">
            <p class="app-footer__copy">&copy; 2025 &mdash; Ficha Tecnica</p>
        </footer>

    </div><!-- /app-wrapper -->

    <script src="/js/sidebar.js"></script>

    <script>
        

        /* ── COLORES POR VENCIMIENTO ────────────────────────────── */
        const DIAS_ROJO     = 30;
        const DIAS_AMARILLO = 90;

        document.querySelectorAll('tbody tr').forEach(fila => {
            const celda = fila.querySelector('td[data-vencimiento]');
            if (!celda) return;

            const fechaStr = celda.getAttribute('data-vencimiento');
            if (!fechaStr) return;

            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            const vencimiento = new Date(fechaStr);
            const diffDias = Math.ceil((vencimiento - hoy) / (1000 * 60 * 60 * 24));

            // Corregido: clase sobre la celda, no sobre la fila
            if (diffDias <= DIAS_ROJO) {
                celda.classList.add('venc-vencido');
            } else if (diffDias <= DIAS_AMARILLO) {
                celda.classList.add('venc-proximo');
            } else {
                celda.classList.add('venc-vigente');
            }
        });

        /* ── BÚSQUEDA EN TIEMPO REAL ────────────────────────────── */
        const inputBuscar = document.querySelector('input[name="buscar"]');

        if (inputBuscar) {
            inputBuscar.addEventListener('input', function () {
                const termino = this.value.toLowerCase().trim();
                const filas   = document.querySelectorAll('tbody tr');

                filas.forEach(fila => {
                    // Busca en todas las celdas de la fila excepto Acciones
                    const celdas  = fila.querySelectorAll('td:not([data-label="Acciones"])');
                    const textoFila = Array.from(celdas)
                        .map(td => td.textContent.toLowerCase())
                        .join(' ');

                    if (textoFila.includes(termino)) {
                        fila.classList.remove('fila-oculta');
                    } else {
                        fila.classList.add('fila-oculta');
                    }
                });
            });
        }
    </script>

</body>
</html>
