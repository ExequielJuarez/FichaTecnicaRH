<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mantenimientos - Gestión de Flota</title>
    <link rel="stylesheet" href="/css/Mantenimientos.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

    <!-- ===================== SIDEBAR ===================== -->
  <%- include('./partials/sidebar') %>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper" id="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <%- include('./partials/topbar') %>

        <!-- ===================== MAIN ===================== -->
        <main class="Main-content">

            <h2>Mantenimientos</h2>
            <p class="descripcion">Historial de mantenimientos de los vehículos.</p>

            <div class="acciones">
                <a href="/Mantenimientos/carga" class="nuevo-mantenimiento">Nuevo Mantenimiento</a>
                <a class="btn-filtrar">Exportar</a>
            </div>

            <section class="box-main">

              <section class="box-filtros">

                <div class="filtro">
                    <label>Buscar</label>
                    <input
                        id="filtro-busqueda"
                        class="input"
                        type="search"
                        placeholder="Patente, servicio..."
                    >
                </div>

                <div class="filtro">
                    <label>Fecha desde</label>
                    <input
                        id="filtro-desde"
                        class="input"
                        type="date"
                    >
                </div>

                <div class="filtro">
                    <label>Fecha hasta</label>
                    <input
                        id="filtro-hasta"
                        class="input"
                        type="date"
                    >
                </div>

                <div class="filtro">
                    <label>Tipo de servicio</label>
                    <input
                        id="filtro-servicio"
                        class="input"
                        type="text"
                        placeholder="Ej: Cambio de aceite"
                    >
                </div>

                <div class="filtro">
                    <label>Estado</label>
                    <select id="filtro-estado" class="input">
                        <option value="">Todos</option>
                        <option value="Realizado">Realizado</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                </div>

                <div class="filtro filtro-boton">
                    <button type="button" class="boton-limpiar" id="btn-limpiar">
                        Limpiar
                    </button>
                </div>

            </section>

                <section class="box-lista">

                    <div class="tabla-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Vehículo</th>
                                    <th>Patente</th>
                                    <th>Servicio</th>
                                    <th>Km</th>
                                    <th>Costo</th>
                                </tr>
                            </thead>
                                <tbody>

                                    <% if (mantenimientos && mantenimientos.length > 0) { %>

                                        <% mantenimientos.forEach(mantenimiento => { %>

                                            <tr
                                                data-fecha="<%= mantenimiento.fecha_inicio %>"
                                                data-vehiculo="<%= mantenimiento.vehiculo?.marca %> <%= mantenimiento.vehiculo?.modelo %>"
                                                data-patente="<%= mantenimiento.vehiculo?.patente %>"
                                                data-servicio="<%= mantenimiento.tipo_servicio %>"
                                                data-estado="<%= mantenimiento.estado %>"
                                            >

                                                <td data-label="Fecha">
                                                    <%= mantenimiento.fecha_inicio %>
                                                </td>

                                                <td data-label="Vehículo">
                                                    <%= mantenimiento.vehiculo?.marca %>
                                                    <%= mantenimiento.vehiculo?.modelo %>
                                                </td>

                                                <td data-label="Patente">
                                                    <%= mantenimiento.vehiculo?.patente %>
                                                </td>

                                                <td data-label="Servicio">
                                                    <%= mantenimiento.tipo_servicio %>
                                                </td>

                                                <td data-label="Km">
                                                    <%= mantenimiento.km_servicio %>
                                                </td>

                                                <td data-label="Costo">
                                                    $<%= mantenimiento.costo_total %>
                                                </td>

                                            </tr>

                                        <% }) %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="6" style="text-align:center;">
                                                No hay mantenimientos registrados
                                            </td>
                                        </tr>

                                    <% } %>

                                </tbody>
                        </table>
                    </div>

                </section>

                <section class="box-cambiarLista">

                    <p class="info">Mostrando 1-8</p>

                    <div class="paginacion">
                        <button class="cambiar">Anterior</button>
                        <button class="pagina">1</button>
                        <button class="pagina">2</button>
                        <button class="cambiar">Siguiente</button>
                    </div>

                </section>

            </section>

        </main>

        <!-- ===================== FOOTER ===================== -->
        <footer class="app-footer">
            <p class="app-footer__copy">&copy; 2025 &mdash; Ficha Tecnica</p>
        </footer>

    </div><!-- /app-wrapper -->
    <script src="/js/sidebar.js"></script>
    <script>
    
    // ── Filtros + Paginación ──────────────────────────────────
    const FILAS_POR_PAGINA = 10;
    const todasLasFilas = Array.from(document.querySelectorAll("tbody tr"));

    const filtroBusqueda = document.getElementById("filtro-busqueda");
    const filtroDesde    = document.getElementById("filtro-desde");
    const filtroHasta    = document.getElementById("filtro-hasta");
    const filtroServicio = document.getElementById("filtro-servicio");
    const filtroEstado   = document.getElementById("filtro-estado");
    const btnLimpiar     = document.getElementById("btn-limpiar");

    // ── Leer patente desde URL si viene de "Ver todos los mantenimientos" ──
    const params = new URLSearchParams(window.location.search);
    const patenteParam = params.get('patente');
    if (patenteParam) {
        filtroBusqueda.value = patenteParam;
    }

    // Elementos de paginación
    const infoPag    = document.querySelector(".info");
    const btnAntes   = document.querySelectorAll(".cambiar")[0];
    const btnSig     = document.querySelectorAll(".cambiar")[1];
    const contenedorPaginas = document.querySelector(".paginacion");

    let paginaActual = 1;
    let filasFiltradas = [...todasLasFilas];

    // Aplica filtros y devuelve las filas que pasan
    function aplicarFiltros() {
        const busqueda = filtroBusqueda.value.toLowerCase();
        const desde    = filtroDesde.value;
        const hasta    = filtroHasta.value;
        const servicio = filtroServicio.value.toLowerCase();
        const estado   = filtroEstado.value;

        return todasLasFilas.filter(fila => {
            const patente      = fila.dataset.patente?.toLowerCase()  || "";
            const vehiculo     = fila.dataset.vehiculo?.toLowerCase() || "";
            const tipoServicio = fila.dataset.servicio?.toLowerCase() || "";
            const estadoFila   = fila.dataset.estado || "";
            const fecha        = fila.dataset.fecha  || "";

            if (busqueda && !patente.includes(busqueda) && !vehiculo.includes(busqueda) && !tipoServicio.includes(busqueda)) return false;
            if (servicio && !tipoServicio.includes(servicio)) return false;
            if (estado   && estadoFila !== estado)            return false;
            if (desde    && fecha < desde)                    return false;
            if (hasta    && fecha > hasta)                    return false;
            return true;
        });
    }

    // Renderiza la página actual sobre las filas filtradas
    function renderizar() {
        const totalPaginas = Math.max(1, Math.ceil(filasFiltradas.length / FILAS_POR_PAGINA));
        if (paginaActual > totalPaginas) paginaActual = totalPaginas;

        const inicio = (paginaActual - 1) * FILAS_POR_PAGINA;
        const fin    = inicio + FILAS_POR_PAGINA;

        // Ocultar todas, mostrar solo las de la página actual
        todasLasFilas.forEach(f => f.style.display = "none");
        filasFiltradas.forEach((f, i) => {
            f.style.display = (i >= inicio && i < fin) ? "" : "none";
        });

        // Info
        const desde = filasFiltradas.length === 0 ? 0 : inicio + 1;
        const hasta  = Math.min(fin, filasFiltradas.length);
        infoPag.textContent = `Mostrando ${desde}-${hasta} de ${filasFiltradas.length}`;

        // Botones numéricos: eliminar los existentes y recrear
        const botonesNum = contenedorPaginas.querySelectorAll(".pagina");
        botonesNum.forEach(b => b.remove());

        // Insertar páginas antes del botón "Siguiente"
        for (let p = 1; p <= totalPaginas; p++) {
            const btn = document.createElement("button");
            btn.className = "pagina";
            btn.textContent = p;
            if (p === paginaActual) {
                btn.style.background      = "#0f172a";
                btn.style.color           = "#fff";
                btn.style.borderColor     = "#0f172a";
            }
            btn.addEventListener("click", () => {
                paginaActual = p;
                renderizar();
            });
            contenedorPaginas.insertBefore(btn, btnSig);
        }

        // Estado de botones anterior/siguiente
        btnAntes.disabled = paginaActual <= 1;
        btnSig.disabled   = paginaActual >= totalPaginas;
        btnAntes.style.opacity = btnAntes.disabled ? "0.4" : "1";
        btnSig.style.opacity   = btnSig.disabled   ? "0.4" : "1";
    }

    function actualizarTodo() {
        paginaActual    = 1;
        filasFiltradas  = aplicarFiltros();
        renderizar();
    }

    // Eventos de filtros
    filtroBusqueda.addEventListener("input",  actualizarTodo);
    filtroDesde.addEventListener("change",    actualizarTodo);
    filtroHasta.addEventListener("change",    actualizarTodo);
    filtroServicio.addEventListener("input",  actualizarTodo);
    filtroEstado.addEventListener("change",  actualizarTodo);

    // Limpiar
    btnLimpiar.addEventListener("click", () => {
        filtroBusqueda.value = "";
        filtroDesde.value    = "";
        filtroHasta.value    = "";
        filtroServicio.value = "";
        filtroEstado.value   = "";
        actualizarTodo();
    });

    // Anterior / Siguiente
    btnAntes.addEventListener("click", () => {
        if (paginaActual > 1) { paginaActual--; renderizar(); }
    });
    btnSig.addEventListener("click", () => {
        const total = Math.ceil(filasFiltradas.length / FILAS_POR_PAGINA);
        if (paginaActual < total) { paginaActual++; renderizar(); }
    });

    // Arranque inicial
    actualizarTodo();
</script>

</body>
</html>
