<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cargar Vehículo - Gestión de Flota</title>
  <link rel="stylesheet" href="/css/CargaChofer.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ===================== SIDEBAR ===================== -->
  <%- include('./partials/sidebar') %>

  <!-- ===================== APP WRAPPER ===================== -->
  <div class="app-wrapper" id="app-wrapper">

    <!-- ===================== HEADER / TOPBAR ===================== -->
    <%- include('./partials/topbar') %>

    <!-- ===================== MAIN ===================== -->
    <main class="main-content">

      <div class="page-header">
        <div>
          <h2 class="page-title">Editar Chofer</h2>
            <p class="page-subtitle">Modificá los datos del chofer.</p>
        </div>
        
      </div>

      <form class="form" action="/Choferes/<%= chofer.id_chofer %>/editar" method="post">

  <section class="form-section">
    <h3>Información Básica</h3>

    <div class="form-group">
      <label>Nombre</label>
      <input class="input <%= errors?.nombre ? 'input-error' : '' %>" name="nombre" type="text" placeholder="Ingrese el nombre" value="<%= old?.nombre || '' %>">
      <% if (errors?.nombre) { %>
        <span class="error"><%= errors.nombre.msg %></span>
      <% } %>
    </div>

    <div class="form-group">
      <label>Apellido</label>
      <input class="input <%= errors?.apellido ? 'input-error' : '' %>" name="apellido" type="text" placeholder="Ingrese el apellido" value="<%= old?.apellido || '' %>">
      <% if (errors?.apellido) { %>
        <span class="error"><%= errors.apellido.msg %></span>
      <% } %>
    </div>

    <div class="form-group">
        <label>DNI <small>(no modificable)</small></label>

        <input 
        class="input" 
        type="text" 
        value="<%= old?.dni || chofer?.dni || '' %>" 
        disabled
        >

        <input 
        type="hidden" 
        name="dni" 
        value="<%= old?.dni || chofer?.dni || '' %>"
        >

        <% if (errors?.dni) { %>
            <span class="error"><%= errors.dni.msg %></span>
        <% } %>
    </div>

    <div class="form-group">
      <label>Fecha de Nacimiento</label>
      <input class="input <%= errors?.fechaNacimiento ? 'input-error' : '' %>" 
            name="fechaNacimiento" type="date" 
            value="<%= old?.fechaNacimiento || '' %>">
      <% if (errors?.fechaNacimiento) { %>
        <span class="error"><%= errors.fechaNacimiento.msg %></span>
      <% } %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Teléfono</label>
        <input class="input <%= errors?.telefono ? 'input-error' : '' %>" name="telefono" type="tel" value="<%= old?.telefono || '' %>">
        <% if (errors?.telefono) { %>
          <span class="error"><%= errors.telefono.msg %></span>
        <% } %>
      </div>
      <div class="form-group">
        <label>E-mail</label>
        <input class="input <%= errors?.email ? 'input-error' : '' %>" name="email" type="email" value="<%= old?.email || '' %>">
        <% if (errors?.email) { %>
          <span class="error"><%= errors.email.msg %></span>
        <% } %>
      </div>
    </div>

    <div class="form-group">
      <label>Dirección</label>
      <input class="input <%= errors?.direccion ? 'input-error' : '' %>" name="direccion" type="text" value="<%= old?.direccion || '' %>">
      <% if (errors?.direccion) { %>
        <span class="error"><%= errors.direccion.msg %></span>
      <% } %>
    </div>
  </section>

  <section class="form-section">
    <h3>Datos laborales</h3>

    <div class="form-row">
      <div class="form-group">
          <label>Fecha de Ingreso</label>
          <input class="input <%= errors?.fechaIngreso ? 'input-error' : '' %>" 
                name="fechaIngreso" type="date" 
                value="<%= old?.fechaIngreso || '' %>">
          <% if (errors?.fechaIngreso) { %>
            <span class="error"><%= errors.fechaIngreso.msg %></span>
          <% } %>
        </div>

      <div class="form-group">
        <label>Estado</label>
        <select class="input <%= errors?.['activo-inactivo'] ? 'input-error' : '' %>" name="activo-inactivo">
          <option value="">Seleccionar</option>
          <option value="Activo"   <%= old?.['activo-inactivo'] === 'Activo'   ? 'selected' : '' %>>Activo</option>
          <option value="Inactivo" <%= old?.['activo-inactivo'] === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
        </select>
        <% if (errors?.['activo-inactivo']) { %>
          <span class="error"><%= errors['activo-inactivo'].msg %></span>
        <% } %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Turno</label>
        <select name="Turno">
          <option value="">Seleccionar</option>
          <option <%= old?.Turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
          <option <%= old?.Turno === 'Tarde'  ? 'selected' : '' %>>Tarde</option>
        </select>
      </div>
    </div>
  </section>

  <section class="form-section">
    <h3>Datos de Licencia</h3>

    <div class="form-group">
      <label>Número de Licencia</label>
      <input class="input <%= errors?.numero_licencia ? 'input-error' : '' %>" name="numero_licencia" type="text" placeholder="Ingrese el número de licencia" value="<%= old?.numero_licencia || '' %>">
      <% if (errors?.numero_licencia) { %>
        <span class="error"><%= errors.numero_licencia.msg %></span>
      <% } %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Categoría de Licencia</label>
        <select class="input <%= errors?.categoria ? 'input-error' : '' %>" name="categoria">
          <option value="">Seleccione categoría</option>
          <option value="A"  <%= old?.categoria === 'A'  ? 'selected' : '' %>>A - Motocicletas</option>
          <option value="B1" <%= old?.categoria === 'B1' ? 'selected' : '' %>>B1 - Autos y camionetas</option>
          <option value="B2" <%= old?.categoria === 'B2' ? 'selected' : '' %>>B2 - Vehículos utilitarios</option>
          <option value="C"  <%= old?.categoria === 'C'  ? 'selected' : '' %>>C - Camiones sin acoplado</option>
          <option value="D"  <%= old?.categoria === 'D'  ? 'selected' : '' %>>D - Transporte de pasajeros</option>
          <option value="E"  <%= old?.categoria === 'E'  ? 'selected' : '' %>>E - Camiones con acoplado</option>
          <option value="G"  <%= old?.categoria === 'G'  ? 'selected' : '' %>>G - Maquinaria especial</option>
        </select>
        <% if (errors?.categoria) { %>
          <span class="error"><%= errors.categoria.msg %></span>
        <% } %>
      </div>

      <div class="form-group">
        <label>Fecha de Emisión</label>
        <input class="input <%= errors?.fecha_emision ? 'input-error' : '' %>" 
              name="fecha_emision" type="date" 
              value="<%= old?.fecha_emision || '' %>">
        <% if (errors?.fecha_emision) { %>
          <span class="error"><%= errors.fecha_emision.msg %></span>
        <% } %>
      </div>
    </div>

    <div class="form-group small">
      <label>Vencimiento</label>
      <input class="input <%= errors?.fecha_vencimiento ? 'input-error' : '' %>" 
            name="fecha_vencimiento" type="date" 
            value="<%= old?.fecha_vencimiento || '' %>">
      <% if (errors?.fecha_vencimiento) { %>
        <span class="error"><%= errors.fecha_vencimiento.msg %></span>
      <% } %>
    </div>
  </section>

  <section class="form-section">
    <h3>Fechas</h3>

    <div class="form-row">
      <div class="form-group">
        <label>Fecha de Alta</label>
        <input name="fecha_alta" type="date">
      </div>

      <div class="form-group">
        <label>Fecha de Baja</label>
        <!-- LE FALTABA name -->
        <input name="fecha_baja" type="date">
      </div>
    </div>
  </section>

  <section class="form-section">
    <h3>Imagenes de la Documentación</h3>

    <div class="upload-box">
      <label for="imagen">Subir imagen</label>
      <!-- LE FALTABA name -->
      <input type="file" id="imagen" name="imagen">
    </div>

    <div id="preview">
      No hay imagen
    </div>
  </section>

  <section class="form-sectionMod">
   
  </section>


  <div class="acciones">
    <!-- IMPORTANTE: este botón no debe enviar -->
    <a href="/Choferes" class="boton-secundario">Volver</a>
  
    <button type="submit" class="boton-primario">
      Guardar Chofer
    </button>
  </div>

  

</form>



    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="app-footer">
      <p class="app-footer__copy">* Campos obligatorios &nbsp;|&nbsp; &copy; 2025 &mdash; Ficha Tecnica</p>
    </footer>

  </div><!-- /app-wrapper -->

  <script src="/js/sidebar.js"></script>
    

</body>
</html>
